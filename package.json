{
  "name": "moodsky",
  "version": "0.1.0",
  "private": true,
  "description": "MoodSky native WeChat Mini Program team foundation",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "cloud:prepare": "node scripts/prepare-cloud.js",
    "cloud:package": "node scripts/package-cloud.js",
    "cloud:database-plan": "node scripts/prepare-database.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "structure:check": "node scripts/check-structure.js",
    "check": "npm run lint && npm run format:check && npm run structure:check && npm test"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10"
  }
}
