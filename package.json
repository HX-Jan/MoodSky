{
  "name": "moodsky",
  "version": "0.2.3",
  "private": true,
  "description": "MoodSky native WeChat Mini Program team foundation",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "cloud:prepare": "node scripts/prepare-cloud.js",
    "cloud:package": "node scripts/package-cloud.js",
    "cloud:database-plan": "node scripts/prepare-database.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "structure:check": "node scripts/check-structure.js",
    "typecheck": "tsc --noEmit --strict --skipLibCheck false --lib es2020 --module commonjs tools/week1-contracts/type-assertions.ts",
    "check": "npm run lint && npm run format:check && npm run structure:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
