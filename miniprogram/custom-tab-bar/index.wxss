.tab-bar {
  position: fixed;
  z-index: 100;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 14rpx 34rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #d9e1da;
}
.tab-item {
  flex: 1;
  min-width: 0;
  padding: 8rpx 0;
  margin: 0 3rpx;
  min-height: 92rpx;
  border-radius: 24rpx;
  background: transparent;
  color: #56656d;
  font-size: 23rpx;
  line-height: 1.5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab-item::after {
  border: 0;
}
.tab-selected {
  color: #386e61;
  background: #eaf1ea;
}
.tab-icon {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 4rpx;
}
