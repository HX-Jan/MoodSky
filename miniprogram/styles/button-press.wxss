/* Spring release: stiffness 260, damping 12, mass 1; sampled at 60 Hz. */
button.button-motion {
  transform-origin: center;
  box-shadow: var(--button-rest-shadow, none);
  transition: box-shadow 160ms ease;
}
button.button-motion.primary-button,
button.button-motion.login-button,
button.button-motion.save-profile,
button.button-motion.task-choice,
button.button-motion.manual-campus-choice {
  --button-rest-shadow: 0 4rpx 12rpx rgba(37, 51, 58, 0.14);
  --button-pressed-shadow: 0 1rpx 3rpx rgba(37, 51, 58, 0.07);
}
button.button-motion.button-released-a {
  animation: button-release-a 1000ms linear both;
}
button.button-motion.button-released-b {
  animation: button-release-b 1000ms linear both;
}
button.button-motion.button-held,
button.button-motion.button-motion-hover {
  transform: scale(0.94);
  box-shadow: var(--button-pressed-shadow, none);
  animation: none;
}
button.button-motion.button-motion-disabled,
button.button-motion[disabled] {
  transform: none;
  box-shadow: none;
}
button.button-motion.button-motion-disabled.button-released-a,
button.button-motion.button-motion-disabled.button-released-b,
button.button-motion[disabled].button-released-a,
button.button-motion[disabled].button-released-b {
  animation: button-settle 1ms linear both;
}
@media (prefers-reduced-motion: reduce) {
  button.button-motion {
    transform: none !important;
    transition: none;
  }
  button.button-motion.button-released-a,
  button.button-motion.button-released-b {
    animation: button-settle 1ms linear both;
  }
}
@keyframes button-settle {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(1);
  }
}

