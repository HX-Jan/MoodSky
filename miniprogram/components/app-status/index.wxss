:host {
  display: block;
}
button {
  min-width: 44px;
  min-height: 44px;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 30rpx;
  background: #e9f1ea;
  color: #30423d;
  font-size: 25rpx;
  line-height: 1.6;
}
.offline {
  background: #f9ecd9;
  color: #775332;
}
.notice text {
  flex: 1;
  min-width: 0;
}
.notice-action {
  flex-shrink: 0;
  margin: 0;
  padding: 6rpx 12rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #386e61;
  background: transparent;
  border-radius: 12rpx;
}
button::after {
  border: 0;
}
.home-entry {
  padding: 12rpx 30rpx 0;
  background: #faf8f3;
}
.home-entry button {
  width: auto;
  display: inline-flex;
  margin: 0;
  padding: 8rpx 22rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #386e61;
  background: #e9f1ea;
  border-radius: 16rpx;
}
.notice-action.button-hover,
.home-entry button.button-hover {
  background: #dce8de;
}
