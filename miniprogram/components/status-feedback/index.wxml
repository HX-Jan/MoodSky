<view class="feedback" role="status" aria-label="{{view.title}}"><view class="symbol {{state === 'loading' ? 'loading' : ''}}">{{view.symbol}}</view><view class="title">{{view.title}}</view><view class="message">{{view.message}}</view><view wx:if="{{code}}" class="trace">{{code}}</view><view wx:if="{{requestId}}" class="trace">请求编号：{{requestId}}</view><button wx:if="{{view.action}}" bindtap="onAction">{{view.action}}</button></view>