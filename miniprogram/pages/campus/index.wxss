page {
  background: #f9fbff;
}
.screen {
  height: 100vh;
  background: #f9fbff;
}
.campus-hero {
  padding: 32rpx 32rpx 36rpx;
  background: linear-gradient(135deg, #c4e9f2 0%, #d7e7f9 50%, #e8d9f8 100%);
  border-radius: 0 0 32rpx 32rpx;
}
.hero-title {
  color: #2b4463;
  font-size: 42rpx;
  line-height: 1.35;
  font-weight: 600;
}
.hero-subtitle {
  margin-top: 12rpx;
  color: #607993;
  font-size: 24rpx;
  line-height: 1.6;
}
.content {
  padding: 32rpx 32rpx 48rpx;
}
.section-title {
  margin-bottom: 16rpx;
  color: #34465b;
  font-size: 28rpx;
  font-weight: 600;
}
.places-card {
  background: linear-gradient(125deg, #fff7ef, #fff0f6);
  border-radius: 24rpx;
  padding: 28rpx;
}
.places-title {
  color: #59475c;
  font-size: 27rpx;
  font-weight: 500;
}
.places-copy {
  color: #857587;
  font-size: 24rpx;
  line-height: 1.7;
  margin-top: 12rpx;
}
.preview-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
}
.preview-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.preview-label {
  color: #584c6b;
  font-size: 26rpx;
  font-weight: 700;
}
.preview-sub {
  color: #82748b;
  font-size: 22rpx;
}
.sky-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
}
.sky-tile {
  min-height: 124rpx;
  border-radius: 18rpx;
  text-align: center;
  box-sizing: border-box;
  padding: 18rpx 2rpx;
}
.sky-sun {
  background: #fff4d9;
  color: #af7836;
}
.sky-soft {
  background: #f4eafa;
  color: #825ca8;
}
.sky-cloud {
  background: #eaf4fb;
  color: #678eaa;
}
.sky-rain {
  background: #e9edf9;
  color: #6677a8;
}
.sky-storm {
  background: #f4eafa;
  color: #7f6a9e;
}
.tile-symbol {
  font-size: 44rpx;
  line-height: 1.1;
}
.tile-name {
  font-size: 24rpx;
  font-weight: 500;
  margin-top: 10rpx;
  white-space: nowrap;
}
.privacy-note {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf0f6;
  color: #6b7b91;
  font-size: 22rpx;
  line-height: 1.6;
}

.preview-title {
  margin-top: 36rpx;
}
