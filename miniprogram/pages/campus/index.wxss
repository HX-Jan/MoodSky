.screen {
  height: 100vh;
  background: var(--color-background);
}
.weather-preview-section {
  margin-top: 32rpx;
}
.weather-preview-card {
  padding: 28rpx;
  margin-top: 16rpx;
  background: #fff;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
}
.weather-preview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin: 24rpx 0;
}
.weather-preview-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 25rpx;
  color: var(--color-text);
}
.weather-preview-symbol {
  font-size: 36rpx;
}
.content {
  padding: 26rpx 46rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.design-title {
  margin-bottom: 18rpx;
}
.design-subtitle {
  margin-bottom: 34rpx;
}
.campus-view {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
  align-items: center;
}
.campus-view-active {
  flex: 1;
  background: #fff;
  border: 1rpx solid var(--color-border);
  border-radius: 31rpx;
  padding: 22rpx;
  text-align: center;
  color: var(--color-primary);
}
.campus-view button {
  display: flex;
  align-items: center;
  gap: 10rpx;
  border-radius: 31rpx;
  margin: 0;
  background: var(--color-brand-soft);
  color: var(--color-primary);
  line-height: 1.5;
  padding: 22rpx;
  font-size: 29rpx;
}
.demo-banner {
  margin: 12rpx 0 28rpx;
}
.demo-label {
  color: var(--color-primary);
  font-size: 25rpx;
  margin-bottom: 8rpx;
}
.demo-copy {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.6;
}
.demo-banner .outline-button {
  font-size: 25rpx;
  min-height: 66rpx;
  margin: 12rpx 0;
}
.demo-banner > view:last-child {
  font-size: 22rpx;
}
.filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 22rpx;
}
.filter-row picker {
  flex: 1;
  min-width: 0;
}
.filter-picker {
  padding: 18rpx;
  border-radius: 23rpx;
  border: 1rpx solid var(--color-border);
  color: var(--color-primary);
  font-size: 25rpx;
}
.list-meta {
  font-size: 23rpx;
  color: var(--color-muted);
  margin: 16rpx 0;
}
.place-card,
.detail-card,
.support-card,
.state-card {
  background: #fff;
  border-radius: 38rpx;
  padding: 31rpx;
  margin-bottom: 24rpx;
}
.place-card-top {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  justify-content: space-between;
}
.place-name {
  color: var(--color-text);
  font-size: 33rpx;
  font-weight: 500;
  flex: 1;
}
.place-status {
  padding: 7rpx 14rpx;
  border-radius: 28rpx;
  background: var(--color-brand-soft);
  color: var(--color-primary);
  font-size: 21rpx;
  flex-shrink: 0;
}
.status-expired,
.status-closed {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}
.place-campus {
  margin: 26rpx 0 16rpx;
  color: var(--color-muted);
  font-size: 26rpx;
}
.place-hours,
.place-access,
.place-foot {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.6;
  margin-top: 8rpx;
}
.place-foot {
  border-top: 1rpx solid var(--color-border);
  padding-top: 16rpx;
  margin-top: 18rpx;
  color: var(--color-primary);
}
.outline-button,
.more-button,
.close-button {
  background: var(--color-brand-soft);
  color: var(--color-primary);
  font-size: 28rpx;
  line-height: 1.5;
  padding: 20rpx;
  min-height: 84rpx;
  border-radius: 31rpx;
  margin: 16rpx 0 0;
}
.outline-button[disabled] {
  color: var(--color-muted);
  background: var(--color-background);
}
.list-end {
  text-align: center;
  color: var(--color-muted);
  font-size: 23rpx;
  margin: 22rpx 0 38rpx;
}
.section-title,
.state-title,
.detail-name {
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.state-copy,
.state-card,
.detail-line,
.detail-warning {
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.7;
}
.detail-line {
  margin-top: 14rpx;
}
.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.detail-head .close-button {
  padding: 8rpx 20rpx;
  min-height: 64rpx;
  margin: 0 0 18rpx;
}
.detail-warning {
  margin-top: 18rpx;
}
.detail-actions {
  display: flex;
  gap: 12rpx;
}
.detail-actions button {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
}
.correction-box {
  border-top: 1rpx solid var(--color-border);
  padding-top: 24rpx;
  margin-top: 26rpx;
}
.correction-title {
  font-size: 29rpx;
  margin-bottom: 18rpx;
}
.correction-box textarea {
  width: 100%;
  height: 210rpx;
  box-sizing: border-box;
  padding: 22rpx;
  background: var(--color-background);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  font-size: 28rpx;
}
.correction-foot {
  text-align: right;
  color: var(--color-muted);
  font-size: 23rpx;
  margin-top: 8rpx;
}
.error-copy {
  color: var(--color-danger);
  font-size: 25rpx;
}
.success-copy {
  color: var(--color-primary);
  font-size: 25rpx;
}
.demo-active {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.demo-active text {
  font-size: 24rpx;
  color: var(--color-muted);
}
.demo-active .outline-button {
  min-height: 64rpx;
  padding: 12rpx 18rpx;
  font-size: 23rpx;
  margin: 0;
  background: transparent;
  border: 1rpx solid var(--color-border);
}

.manual-campus {
  padding-bottom: 180rpx;
}
.manual-campus-subtitle {
  color: #56656d;
  font-size: 26rpx;
  margin-top: 12rpx;
}
.manual-campus-note {
  color: #56656d;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 24rpx;
}
.manual-campus-place {
  padding: 32rpx 0;
  border-bottom: 1rpx solid #dddeda;
}
.manual-campus-place-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
}
.manual-campus-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #25333a;
}
.manual-campus-tag {
  font-size: 24rpx;
  color: #56656d;
}
.manual-campus-description {
  font-size: 28rpx;
  color: #25333a;
  line-height: 1.65;
  margin-top: 14rpx;
}
.manual-campus-directions {
  font-size: 26rpx;
  color: #56656d;
  line-height: 1.65;
  margin-top: 12rpx;
}
.manual-campus-complete {
  margin: 24rpx 0 0;
  min-height: 88rpx;
  border: 1rpx solid #386e61;
  border-radius: 16rpx;
  background: #386e61;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.5;
  padding: 18rpx 24rpx;
}
.manual-campus-complete::after,
.manual-campus-retry::after,
.manual-campus-weather::after {
  border: 0;
}
.manual-campus-complete[disabled] {
  background: #eaf1ea;
  color: #56656d;
  border-color: #d2ded6;
  opacity: 1;
}
.manual-campus-done .manual-campus-button-label {
  color: #386e61;
}
.manual-campus-pressed {
  opacity: 0.75;
  transform: translateY(1rpx);
}
.manual-campus-message {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #dddeda;
  border-radius: 16rpx;
  color: #56656d;
  font-size: 26rpx;
  line-height: 1.6;
  background: #fff;
}
.manual-campus-retry,
.manual-campus-weather {
  min-height: 88rpx;
  color: #386e61;
  background: transparent;
  font-size: 28rpx;
  line-height: 1.5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.manual-campus-retry {
  margin-top: 12rpx;
  border: 1rpx solid #d2ded6;
  border-radius: 12rpx;
}
.manual-campus-footnote {
  margin-top: 28rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #56656d;
}
.manual-campus-weather {
  width: 100%;
  padding: 0;
  justify-content: space-between;
}
.manual-campus-weather-icons {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}
.manual-campus-weather-icons {
  flex-wrap: wrap;
  font-size: 24rpx;
}
.manual-campus-weather-icons > view {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.manual-campus-complete[disabled] .manual-campus-button-label {
  color: #56656d;
}
.manual-campus-complete.manual-campus-done .manual-campus-button-label {
  color: #386e61;
}

.manual-campus-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.manual-campus-summary .manual-campus-subtitle {
  margin-top: 0;
}
.manual-campus-history-toggle {
  min-height: 88rpx;
  margin: 0;
  padding: 16rpx 0 16rpx 20rpx;
  display: flex;
  align-items: center;
  color: #386e61;
  background: transparent;
  font-size: 26rpx;
  line-height: 1.5;
}
.manual-campus-history {
  padding: 8rpx 24rpx 24rpx;
  border: 1rpx solid #dddeda;
  border-radius: 16rpx;
  background: #fff;
}
.manual-campus-history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0eb;
  color: #25333a;
  font-size: 28rpx;
  line-height: 1.6;
}
.manual-campus-history-date {
  color: #56656d;
  font-size: 24rpx;
}
.manual-campus-history-more {
  min-height: 88rpx;
  margin-top: 20rpx;
  border: 1rpx solid #d2ded6;
  border-radius: 12rpx;
  background: #fff;
  color: #386e61;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.5;
}
