page {
  background: #f9fbff;
}
.screen {
  height: 100vh;
  background: #f9fbff;
}
.campus-hero {
  position: relative;
  overflow: hidden;
  min-height: 390rpx;
  padding: 48rpx 36rpx 30rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #c4e9f2 0%, #d7e7f9 50%, #e8d9f8 100%);
  border-radius: 0 0 62rpx 62rpx;
}
.hero-circle {
  position: absolute;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: #ffffff57;
  top: -150rpx;
  right: -110rpx;
}
.hero-kicker {
  position: relative;
  color: #527e9a;
  letter-spacing: 3rpx;
  font-size: 20rpx;
  font-weight: 700;
}
.hero-title {
  position: relative;
  margin-top: 30rpx;
  max-width: 530rpx;
  color: #2b4463;
  font-size: 42rpx;
  line-height: 1.35;
  font-weight: 700;
}
.hero-subtitle {
  position: relative;
  margin-top: 22rpx;
  max-width: 520rpx;
  color: #607993;
  font-size: 22rpx;
  line-height: 1.6;
}
.hero-sky {
  position: absolute;
  bottom: 8rpx;
  right: 18rpx;
  width: 180rpx;
  height: 160rpx;
}
.hero-sky .sky-sun {
  position: absolute;
  right: 28rpx;
  top: 4rpx;
  color: #ffcf78;
  font-size: 98rpx;
}
.hero-cloud {
  position: absolute;
  bottom: -20rpx;
  left: -5rpx;
  color: #fff;
  font-size: 130rpx;
  text-shadow: 0 10rpx 18rpx #9ab9d270;
}
.sky-star {
  position: absolute;
  right: 0;
  bottom: 15rpx;
  color: #b182d8;
  font-size: 28rpx;
}
.content {
  padding: 45rpx 32rpx 70rpx;
}
.section-kicker {
  color: #7d9fbc;
  letter-spacing: 3rpx;
  font-size: 20rpx;
  font-weight: 700;
  margin-left: 7rpx;
}
.section-title {
  margin: 8rpx 7rpx 23rpx;
  color: #34465b;
  font-size: 34rpx;
  font-weight: 700;
}
.title-flower {
  color: #dda1d3;
  font-size: 28rpx;
}
.places-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(125deg, #fff7ef, #fff0f6);
  border-radius: 32rpx;
  padding: 31rpx;
  box-shadow: 0 12rpx 35rpx #67769b0e;
}
.places-art {
  position: absolute;
  right: 19rpx;
  top: 5rpx;
  color: #f2caab;
  font-size: 80rpx;
}
.places-art text {
  color: #fff;
  font-size: 75rpx;
}
.places-title {
  position: relative;
  color: #59475c;
  font-size: 27rpx;
  font-weight: 700;
}
.places-copy {
  position: relative;
  max-width: 540rpx;
  color: #857587;
  font-size: 22rpx;
  line-height: 1.7;
  margin-top: 17rpx;
}
.places-pill {
  display: inline-block;
  margin-top: 22rpx;
  padding: 10rpx 20rpx;
  background: #ffffffaf;
  border-radius: 22rpx;
  color: #ae7f99;
  font-size: 20rpx;
}
.preview-kicker {
  margin-top: 47rpx;
}
.preview-card {
  background: #fff;
  border-radius: 34rpx;
  padding: 27rpx;
  box-shadow: 0 12rpx 35rpx #67769b12;
}
.preview-top {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}
.preview-icon {
  width: 65rpx;
  height: 65rpx;
  border-radius: 22rpx;
  background: #f1e8fd;
  color: #b18ada;
  line-height: 65rpx;
  text-align: center;
  font-size: 38rpx;
}
.preview-heading {
  margin-left: 17rpx;
}
.preview-label {
  color: #584c6b;
  font-size: 26rpx;
  font-weight: 700;
}
.preview-sub {
  color: #9a8eaa;
  font-size: 20rpx;
  margin-top: 4rpx;
}
.sky-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 14rpx;
}
.sky-tile {
  width: 30%;
  min-height: 147rpx;
  border-radius: 23rpx;
  text-align: center;
  box-sizing: border-box;
  padding: 13rpx 3rpx;
}
.sky-sun {
  background: #fff4d9;
  color: #af7836;
}
.sky-soft {
  background: #f4eafa;
  color: #825ca8;
}
.sky-cloud {
  background: #eaf4fb;
  color: #678eaa;
}
.sky-rain {
  background: #e9edf9;
  color: #6677a8;
}
.sky-storm {
  background: #f4eafa;
  color: #7f6a9e;
}
.tile-symbol {
  font-size: 51rpx;
  line-height: 1.1;
}
.tile-name {
  font-size: 21rpx;
  font-weight: 700;
  margin-top: 6rpx;
}
.tile-caption {
  font-size: 17rpx;
  opacity: 0.75;
  margin-top: 4rpx;
}
.privacy-note {
  display: flex;
  gap: 13rpx;
  align-items: flex-start;
  margin-top: 23rpx;
  padding: 19rpx;
  background: #f6f8fc;
  border-radius: 20rpx;
  color: #7e8ba0;
  font-size: 21rpx;
  line-height: 1.6;
}
.note-lock {
  color: #9b8eae;
  font-size: 28rpx;
  line-height: 1.1;
}
.footer {
  padding: 45rpx 0 10rpx;
  color: #a1a9bb;
  font-size: 21rpx;
  text-align: center;
}

.demo-banner,
.location-card,
.detail-card,
.support-card {
  margin-bottom: 28rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx #67769b10;
}
.demo-banner {
  background: #fff7e6;
  border: 1rpx solid #f1d9a9;
}
.demo-label,
.correction-title {
  color: #755b31;
  font-size: 24rpx;
  font-weight: 700;
}
.demo-copy,
.location-copy,
.state-copy,
.location-state,
.map-message,
.error-copy,
.success-copy {
  margin-top: 12rpx;
  color: #6f7080;
  font-size: 22rpx;
  line-height: 1.65;
}
.filter-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.filter-row picker {
  flex: 1;
}
.filter-picker {
  overflow: hidden;
  padding: 17rpx 18rpx;
  border: 1rpx solid #dfe6f0;
  border-radius: 18rpx;
  color: #475b73;
  font-size: 21rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.list-meta,
.list-end,
.correction-foot {
  margin: 12rpx 5rpx 16rpx;
  color: #9299aa;
  font-size: 20rpx;
}
.state-card {
  margin-bottom: 24rpx;
  padding: 34rpx 26rpx;
  border-radius: 26rpx;
  background: #f5f7fc;
  color: #68758c;
  text-align: center;
  font-size: 23rpx;
  line-height: 1.6;
}
.state-title {
  color: #3e506a;
  font-size: 27rpx;
  font-weight: 700;
}
.place-card {
  margin-bottom: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #e7ebf2;
  border-radius: 26rpx;
  background: #ffffff;
}
.place-card-top,
.detail-head,
.detail-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.place-name,
.detail-name {
  color: #354b65;
  font-size: 27rpx;
  font-weight: 700;
}
.place-status {
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  border-radius: 18rpx;
  font-size: 18rpx;
}
.status-open {
  background: #edf8f1;
  color: #4d8b63;
}
.status-expired,
.status-closed {
  background: #fff0ed;
  color: #b55e56;
}
.status-unknown {
  background: #f3f0fa;
  color: #806da1;
}
.place-campus,
.place-hours,
.place-access,
.place-foot,
.detail-line {
  margin-top: 12rpx;
  color: #69798d;
  font-size: 21rpx;
  line-height: 1.55;
}
.place-foot {
  color: #9aa3b2;
  font-size: 19rpx;
}
.more-button,
.outline-button,
.close-button {
  min-height: 0;
  margin: 16rpx 0 0;
  padding: 11rpx 18rpx;
  border: 1rpx solid #d7c9eb;
  border-radius: 18rpx;
  background: #fbf9ff;
  color: #735598;
  font-size: 21rpx;
  line-height: 1.5;
}
.more-button::after,
.outline-button::after,
.close-button::after {
  border: 0;
}
.list-end {
  text-align: center;
}
.small-title {
  margin: 0;
  font-size: 28rpx;
}
.location-card {
  margin-top: 36rpx;
  background: #f7fbff;
}
.location-card .section-kicker,
.support-card .section-kicker {
  margin-left: 0;
}
.detail-card {
  border: 2rpx solid #e1d5f1;
  background: #fff;
}
.close-button {
  margin: 0;
  padding: 7rpx 15rpx;
}
.detail-name {
  margin-top: 16rpx;
}
.detail-warning {
  margin-top: 20rpx;
  padding: 17rpx;
  border-radius: 17rpx;
  background: #fff6e8;
  color: #86683b;
  font-size: 21rpx;
  line-height: 1.6;
}
.detail-actions {
  align-items: stretch;
  margin-top: 8rpx;
}
.detail-actions .outline-button {
  flex: 1;
}
.map-message {
  padding: 14rpx;
  border-radius: 15rpx;
  background: #fff1f0;
  color: #a45b58;
}
.correction-box {
  margin-top: 28rpx;
  padding-top: 23rpx;
  border-top: 1rpx solid #edf0f5;
}
.correction-box textarea {
  width: 100%;
  min-height: 130rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx solid #dfe6f0;
  border-radius: 16rpx;
  color: #44566d;
  font-size: 22rpx;
}
.correction-foot {
  margin-bottom: 0;
  text-align: right;
}
.error-copy {
  color: #a44f58;
}
.success-copy {
  color: #4d8162;
}
.support-card {
  margin-top: 28rpx;
  background: #fffafd;
}

.place-card-top {
  align-items: flex-start;
  flex-wrap: wrap;
}
.place-name {
  min-width: 0;
  overflow-wrap: anywhere;
}
