<scroll-view scroll-y class="screen">
  <view class="campus-hero">
    <view class="hero-title">校园</view>
    <view class="hero-subtitle">地点与天气</view>
  </view>
  <view class="content">
    <view class="section-title">校园地点</view>
    <view class="places-card">
      <view class="places-title">地点资料整理中</view>
      <view class="places-copy">地点和支持资源核实后会在这里展示，地图与收藏暂未开放。</view>
    </view>

    <view class="section-title preview-title">校园天气</view>
    <view class="preview-card">
      <view class="preview-top"><view class="preview-label">{{preview.label}}</view><view class="preview-sub">非实时数据</view></view>
      <view class="sky-grid">
        <view wx:for="{{preview.skies}}" wx:key="name" class="sky-tile sky-{{item.shade}}">
          <view class="tile-symbol">{{item.symbol}}</view><view class="tile-name">{{item.name}}</view>
        </view>
      </view>
      <view class="privacy-note">{{preview.description}}</view>
    </view>
  </view>
</scroll-view>

