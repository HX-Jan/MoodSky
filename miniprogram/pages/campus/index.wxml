<scroll-view scroll-y="true" class="screen">
  <view class="campus-hero">
    <view class="hero-circle"></view>
    <view class="hero-kicker">☁ MOODSKY / CAMPUS</view>
    <view class="hero-title">在校园里，<br />找到一片适合自己的天空</view>
    <view class="hero-subtitle">地点资料先核验，再推荐；合成数据只用于交互演示。</view>
    <view class="hero-sky" aria-hidden="true"><text class="sky-sun">☀</text><text class="hero-cloud">☁</text><text class="sky-star">✦</text></view>
  </view>

  <view class="content">
    <view class="demo-banner">
      <view class="demo-label">资料边界</view>
      <view class="demo-copy">真实地点资料待核验。演示仅包含虚构地点，收藏与审核反馈只在本次页面内展示。</view>
      <button wx:if="{{!demoEnabled}}" class="outline-button" bindtap="onStartDemo">开始合成演示</button>
      <button wx:else class="outline-button" bindtap="onStopDemo">退出并清除演示</button>
      <view wx:if="{{demoEnabled}}">{{modeLabel}} · 状态参考日期 {{demoDate}}</view>
    </view>

    <view class="section-kicker">EXPLORE / 01</view>
    <view class="section-title">校园地点列表</view>
    <view wx:if="{{demoEnabled}}" class="filter-row">
      <picker id="campus-filter" mode="selector" range="{{campusOptions}}" value="{{campusIndex}}" bindchange="onCampusChange">
        <view class="filter-picker">校区：{{selectedCampus}}⌄</view>
      </picker>
      <picker id="tag-filter" mode="selector" range="{{tagOptions}}" value="{{tagIndex}}" bindchange="onTagChange">
        <view class="filter-picker">标签：{{selectedTag}}⌄</view>
      </picker>
    </view>
    <view wx:if="{{demoEnabled}}" class="list-meta">合成演示结果 {{total}} 条 · 第 {{page}} 页</view>

    <view wx:if="{{listState === 'unverified'}}" class="state-card">暂无经过核验的地点资料。可主动开启合成演示查看交互。</view>
    <view wx:elif="{{listState === 'loading'}}" class="state-card">正在读取合成列表…</view>
    <view wx:elif="{{listState === 'empty'}}" class="state-card empty-card">
      <view class="state-title">没有匹配的地点</view>
      <view class="state-copy">请更换校区或环境标签；无结果是正常成功状态。</view>
    </view>
    <block wx:else>
      <view wx:for="{{places}}" wx:key="placeId" class="place-card" bindtap="onPlaceTap" data-id="{{item.placeId}}">
        <view class="place-card-top">
          <view class="place-name">{{item.name}}</view>
          <view class="place-status status-{{item.status}}">{{item.statusLabel}}</view>
        </view>
        <view class="place-campus">{{item.campus}} · {{item.tagText}}</view>
        <view class="place-hours">开放信息：{{item.openHours}}</view>
        <view class="place-access">无障碍：{{item.accessibleText}}</view>
        <view class="place-foot">核验日期：{{item.verifiedAt}} · 坐标：{{item.coordinateStatus}}</view>
      </view>
      <button wx:if="{{hasMore}}" class="more-button" bindtap="onLoadMore">加载下一页</button>
      <view wx:else class="list-end">已到合成演示列表末尾</view>
    </block>

    <view class="location-card">
      <view class="section-kicker">LOCATION / 02</view>
      <view class="section-title small-title">定位由你主动选择</view>
      <view class="location-copy">首次进入不会申请定位。点击后进行定位能力小验证；结果立即丢弃，不保存、不上传，也不用于附近排序。拒绝后仍能浏览列表。</view>
      <button class="outline-button" disabled="{{locationBusy}}" bindtap="onRequestLocation">尝试定位（由你主动点击）</button>
      <view class="location-state">{{locationState}}</view>
    </view>

    <view wx:if="{{selectedPlace}}" class="detail-card">
      <view class="detail-head"><view class="section-title small-title">地点详情</view><button class="close-button" bindtap="onCloseDetail">关闭</button></view>
      <view class="detail-name">{{selectedPlace.name}}</view>
      <view class="detail-line">地址：{{selectedPlace.address}}</view>
      <view class="detail-line">开放信息：{{selectedPlace.openHours}}</view>
      <view class="detail-line">无障碍说明：{{selectedPlace.accessibleText}}</view>
      <view class="detail-line">核验日期：{{selectedPlace.verifiedAt}} · 有效期至：{{selectedPlace.validUntil}}</view>
      <view class="detail-line">来源：{{selectedPlace.source}}</view>
      <view class="detail-warning">{{selectedPlace.statusLabel}}；资料未核验前不作为真实前往建议。</view>
      <view class="detail-actions">
        <button class="outline-button" bindtap="onToggleFavorite">{{selectedPlaceFavorited ? '取消收藏（本地演示）' : '收藏（本地演示）'}}</button>
        <button class="outline-button" disabled="{{!selectedPlace.navigationAvailable}}" bindtap="onNavigate">主动打开地图</button>
      </view>
      <view wx:if="{{mapState === 'unavailable'}}" class="map-message">地图字段未核验或坐标不可用，无法导航。</view>
      <view wx:if="{{mapState === 'failed'}}" class="map-message">地图打开失败。你仍可返回列表继续浏览。</view>
      <button wx:if="{{mapState === 'failed' || mapState === 'unavailable'}}" class="more-button" bindtap="onMapBack">返回列表</button>
      <view wx:if="{{!selectedPlace.navigationAvailable}}" class="map-message">合成或未核验坐标不启用真实导航。</view>
      <button wx:if="{{demoEnabled}}" class="more-button" bindtap="onSimulateMapFailure">模拟地图失败（不调用地图）</button>
      <view class="correction-box">
        <view class="correction-title">资料纠错流程演示（未发送）</view>
        <textarea maxlength="-1" value="{{correctionText}}" bindinput="onCorrectionInput" placeholder="请输入 1—{{correctionLimit}} 个 Unicode 码点的纠错说明"></textarea>
        <view class="correction-foot">{{correctionCount}} / {{correctionLimit}}</view>
        <button class="outline-button" bindtap="onSubmitCorrection">演示提交审核（不上传）</button>
        <view wx:if="{{correctionState === 'invalid'}}" class="error-copy">纠错内容必须为 1—200 个 Unicode 码点。</view>
        <view wx:if="{{correctionState === 'pending'}}" class="success-copy">已进入待审核演示状态；不会自动发布到地点列表。</view>
        <view wx:if="{{correctionState === 'pending'}}">
          <button class="more-button" bindtap="onReviewDemo" data-status="approved">模拟审核通过</button>
          <button class="more-button" bindtap="onReviewDemo" data-status="rejected">模拟审核驳回</button>
        </view>
        <view wx:if="{{correctionState === 'approved'}}">合成反馈：审核通过；未修改地点资料。</view>
        <view wx:if="{{correctionState === 'rejected'}}">合成反馈：需要补充依据。输入已保留，可修改后再演示提交。</view>
      </view>
    </view>

    <view class="support-card">
      <view class="section-kicker">SUPPORT / 03</view>
      <view class="section-title small-title">支持资源</view>
      <view class="state-copy">{{supportState === 'pending' ? '暂无经过授权核验的支持资源；当前保持待核验空态。' : '真实接口尚未实现；没有写入或生成支持资源。'}}</view>
      <button class="outline-button" bindtap="onSupportResources">查看接入状态</button>
    </view>

    <view class="section-kicker preview-kicker">WEATHER / 04</view>
    <view class="section-title">校园天气小剧场 <text class="title-flower">✦</text></view>
    <view class="preview-card">
      <view class="preview-top"><view class="preview-icon">✳</view><view class="preview-heading"><view class="preview-label">{{preview.label}}</view><view class="preview-sub">五种心情天气 · 纯界面示意</view></view></view>
      <view class="sky-grid">
        <view wx:for="{{preview.skies}}" wx:key="name" class="sky-tile sky-{{item.shade}}">
          <view class="tile-symbol">{{item.symbol}}</view><view class="tile-name">{{item.name}}</view><view class="tile-caption">{{item.caption}}</view>
        </view>
      </view>
      <view class="privacy-note"><text class="note-lock">♧</text><text>{{preview.description}}</text></view>
    </view>
    <view class="footer">每一种天气，都值得被温柔对待 ♡</view>
  </view>
</scroll-view>
