<share-entry wx:if="{{shareSinglePage}}" title="{{sharePageTitle}}" description="{{sharePageDescription}}" />
<block wx:if="{{!shareSinglePage}}">
<app-status />
<scroll-view wx:if="{{manualCheckinMode}}" scroll-y="true" class="screen" scroll-into-view="{{checkinScrollTarget}}" refresher-enabled="{{true}}" refresher-triggered="{{checkinRefreshing}}" refresher-background="#faf8f3" bindrefresherrefresh="onCheckinRefresh" bindrefresherabort="onCheckinRefreshAbort">
  <view class="content manual-campus">
    <view class="design-title">校园地点</view>
    <view class="manual-campus-subtitle">福州大学旗山校区</view>
    <view class="manual-campus-note">选个地方走走，到达后点完成打卡。</view>
    <view wx:if="{{checkinError}}" class="manual-campus-message" role="alert">
      <view>{{checkinError}}</view>
      <button class="manual-campus-retry" bindtap="onCheckinRetry" disabled="{{checkinBusy}}" hover-class="manual-campus-pressed">{{checkinPendingPlace ? '重试打卡' : '重新读取'}}</button>
    </view>
    <view wx:if="{{checkinLoading}}" class="manual-campus-note">正在读取打卡记录…</view>
    <view wx:for="{{checkinPlaces}}" wx:key="placeId" id="checkin-place-{{item.placeId}}" class="manual-campus-place">
      <view class="manual-campus-place-heading">
        <view class="manual-campus-name">{{item.name}}</view>
        <view class="manual-campus-tag">{{item.tag}}</view>
      </view>
      <view class="manual-campus-description">{{item.description}}</view>
      <view class="manual-campus-directions">{{item.directions}}</view>
      <button class="manual-campus-complete {{item.completed ? 'manual-campus-done' : ''}}" bindtap="onCheckinTap" data-place-id="{{item.placeId}}" disabled="{{item.completed || checkinBusy || checkinPendingPlace || checkinLoading || checkinStorageBlocked || checkinWritesUnavailable}}" loading="{{checkinBusy && checkinPendingPlace === item.placeId}}" hover-class="manual-campus-pressed"><text class="manual-campus-button-label">{{item.completed ? '今日已打卡' : (checkinPendingPlace === item.placeId ? '等待确认' : (checkinWritesUnavailable ? '暂不可打卡' : '完成打卡'))}}</text></button>
    </view>
    <view class="manual-campus-footnote">开放情况以现场为准，请留意校园公告。</view>
    <view id="checkin-history" class="manual-campus-history-section">
      <button class="manual-campus-history-toggle" bindtap="onCheckinHistory" aria-expanded="{{checkinHistoryOpen}}" disabled="{{!checkinHistoryOpen && (checkinBusy || checkinPendingPlace || checkinStorageBlocked || checkinLoading)}}" hover-class="manual-campus-pressed"><text>我的打卡</text><text class="manual-campus-history-meta">{{checkinHistoryOpen ? '收起' : '展开'}}</text></button>
      <view wx:if="{{checkinHistoryOpen}}" class="manual-campus-history">
        <view wx:for="{{checkinHistory}}" wx:key="key" class="manual-campus-history-row"><view><view class="manual-campus-history-name">{{item.name}}</view><view class="manual-campus-history-meta">{{item.date}}</view></view><text class="manual-campus-history-meta">{{item.time}}</text></view>
        <view wx:if="{{checkinHistoryBusy}}" class="manual-campus-note">正在读取…</view>
        <view wx:if="{{checkinHistoryEmpty}}" class="manual-campus-note">还没有打卡记录</view>
        <view wx:if="{{checkinHistoryError}}" class="manual-campus-note" role="alert">{{checkinHistoryError}}</view>
        <view class="manual-campus-history-actions">
          <button wx:if="{{checkinHistoryError}}" class="manual-campus-history-action manual-campus-history-retry" bindtap="onCheckinHistoryRetry" disabled="{{checkinHistoryBusy || checkinLoading}}" hover-class="manual-campus-pressed">{{checkinHistoryRestart ? '重新读取' : '重试'}}</button>
          <block wx:else>
            <button wx:if="{{checkinHistoryLoaded}}" class="manual-campus-history-action" bindtap="onCheckinHistoryRefresh" disabled="{{checkinHistoryBusy || checkinLoading}}" hover-class="manual-campus-pressed">刷新记录</button>
            <button wx:if="{{checkinHistoryMore}}" class="manual-campus-history-action manual-campus-history-more" bindtap="onCheckinHistoryMore" disabled="{{checkinHistoryBusy || checkinLoading}}" hover-class="manual-campus-pressed">加载更多</button>
          </block>
        </view>
      </view>
    </view>
    <view class="weather-preview-section">
      <button class="manual-campus-weather" bindtap="onToggleWeatherPreview" hover-class="manual-campus-pressed">校园天气示意 {{weatherPreviewExpanded ? '收起' : '展开'}}</button>
      <view wx:if="{{weatherPreviewExpanded}}" class="manual-campus-note">固定天气示意，不是实时天气。</view>
      <view wx:if="{{weatherPreviewExpanded}}" class="manual-campus-weather-icons">
        <view wx:for="{{preview.skies}}" wx:key="name"><text class="weather-preview-symbol">{{item.symbol}}</text><text>{{item.name}}</text></view>
      </view>
    </view>
  </view>
</scroll-view>
<scroll-view wx:else scroll-y="true" scroll-into-view="{{detailScrollTarget}}" scroll-with-animation="true" class="screen">
  <view class="content">
    <view class="design-title">校园地点</view>
    <view class="design-subtitle">发现校园里适合散步、阅读和短休的地点。</view>
    <view class="campus-view">
      <view class="campus-view-active">推荐地点</view>
      <button bindtap="onToggleFilters"><image class="design-icon" src="/assets/jiaqi/filter-active.png" />筛选</button>
    </view>

    <view class="demo-banner" wx:if="{{!isExperience && !isProduction}}">
      <block wx:if="{{!demoEnabled}}">
        <view class="demo-copy">可查看成员提交的地点资料本地预览、合成数据交互演示，或读取云端接口。</view>
        <button class="outline-button" bindtap="onStartFieldNotePreview">查看成员提交资料</button>
        <button class="outline-button" bindtap="onStartDemo">开始合成演示</button>
        <button class="outline-button" disabled="{{cloudState === 'loading'}}" bindtap="onLoadCloudPlaces">{{cloudState === 'loading' ? '正在读取…' : (catalogMode === 'cloud' ? '刷新云端地点' : '读取云端地点')}}</button>
      </block>
      <view wx:else class="demo-active">
        <text>{{modeLabel}}</text>
        <button class="outline-button" bindtap="onLoadCloudPlaces">读取云端列表</button>
        <button class="outline-button" bindtap="onStopDemo">退出预览</button>
      </view>
    </view>

    <view class="demo-banner" wx:if="{{isExperience}}">校园资料预览 · 成员提交，尚待复核；不作为前往推荐。</view>
    <view wx:if="{{filtersExpanded}}" class="filter-row">
      <picker id="campus-filter" mode="selector" range="{{campusOptions}}" value="{{campusIndex}}" bindchange="onCampusChange">
        <view class="filter-picker">校区：{{selectedCampus}}⌄</view>
      </picker>
      <picker id="tag-filter" mode="selector" range="{{tagOptions}}" value="{{tagIndex}}" bindchange="onTagChange">
        <view class="filter-picker">标签：{{selectedTag}}⌄</view>
      </picker>
    </view>
    <view wx:if="{{demoEnabled || catalogMode === 'cloud'}}" class="list-meta">{{catalogMode === 'cloud' ? '推荐地点' : modeLabel}} · {{total}} 条 · 第 {{page}} 页</view>

    <view wx:if="{{listState === 'unverified'}}" class="state-card">地点资料尚未就绪，请稍后再来。</view>
    <view wx:elif="{{listState === 'loading'}}" class="state-card">正在读取地点列表…</view>
    <view wx:elif="{{listState === 'error'}}" class="state-card empty-card">
      <view class="state-title">地点列表读取失败</view>
      <view class="state-copy">{{cloudMessage || '请稍后重试。'}}</view>
      <button class="outline-button" bindtap="onLoadCloudPlaces">重新加载</button>
    </view>
    <view wx:elif="{{listState === 'empty'}}" class="state-card empty-card">
      <view class="state-title">没有匹配的地点</view>
      <view class="state-copy">试试更换校区或标签。</view>
    </view>
    <block wx:else>
      <view wx:for="{{places}}" wx:key="placeId" class="place-card" bindtap="onPlaceTap" data-id="{{item.placeId}}">
        <view class="place-card-top">
          <view class="place-name">{{item.name}}</view>
          <view class="place-status status-{{item.status}}">{{item.statusLabel}}</view>
        </view>
        <view class="place-campus">{{item.campus}} · {{item.tagText}}</view>
        <view class="place-hours">开放信息：{{item.openHours}}</view>
        <view class="place-foot">{{item.verificationLabel}} · {{item.recommendationLabel}}</view>
      </view>
      <button wx:if="{{hasMore}}" class="more-button" disabled="{{listLoadingMore}}" bindtap="onLoadMore">{{listLoadingMore ? '正在加载…' : (listMoreError ? '重试下一页' : '加载下一页')}}</button>
      <view wx:if="{{listMoreError}}" class="error-copy">{{listMoreError}}；当前页内容已保留。</view>
      <view wx:if="{{!hasMore && !listMoreError && places.length}}" class="list-end">已到当前列表末尾。</view>
    </block>

    <view wx:if="{{detailState === 'loading'}}" class="state-card">正在读取地点详情…</view>
    <view wx:if="{{detailState === 'error'}}" class="state-card">
      <view class="state-title">地点详情读取失败</view>
      <view class="error-copy">{{detailError}}</view>
      <button class="outline-button" bindtap="onRetryDetail">重试读取详情</button>
    </view>
    <view wx:if="{{selectedPlace}}" id="campus-place-detail" class="detail-card">
      <view class="detail-head"><view class="section-title small-title">地点详情</view><button class="close-button" bindtap="onCloseDetail">关闭</button></view>
      <view class="detail-name">{{selectedPlace.name}}</view>
      <view wx:if="{{selectedPlace.akaName}}" class="detail-line">常用称呼：{{selectedPlace.akaName}}</view>
      <view class="detail-line">前往说明：{{selectedPlace.address || '文字方位待补充'}}</view>
      <view class="detail-line">适合场景：{{selectedPlace.tagText || '待补充'}}</view>
      <view class="detail-line">开放信息：{{selectedPlace.openHours || '待核验'}}</view>
      <view class="detail-line">记录日期：{{selectedPlace.memberCheckedAt || selectedPlace.verifiedAt || '未提供'}} · 状态：{{selectedPlace.verificationLabel}}</view>
      <view class="detail-line">来源记录：{{selectedPlace.sourceText}}</view>
      <view class="detail-warning">{{selectedPlace.recommendationLabel}}。开放与进入限制请以核验信息及现场提示为准。</view>
      <view class="state-copy">到访打卡暂未开放。</view>
      <view class="detail-actions" wx:if="{{!isProduction}}">
        <button class="outline-button" disabled="{{catalogMode === 'field-note' || favoriteState === 'loading' || favoriteBusy || favoriteState === 'unavailable' || (favoriteState === 'error' && !favoritePendingOperation)}}" bindtap="onToggleFavorite">{{catalogMode === 'cloud' ? (selectedPlaceFavorited ? '取消收藏' : '收藏') : (selectedPlaceFavorited ? '取消收藏（合成演示）' : '收藏（合成演示）')}}</button>
      </view>
      <view wx:if="{{catalogMode === 'field-note'}}" class="state-copy">本地资料预览不读取或修改真实账号收藏。</view>
      <view wx:if="{{favoriteState === 'loading'}}" class="state-copy">正在读取或保存账号收藏…</view>
      <view wx:if="{{favoriteState === 'error' || favoriteState === 'unavailable'}}" class="error-copy">{{favoriteError}}</view>
      <button wx:if="{{favoriteState === 'error' && favoritePendingOperation}}" class="more-button" bindtap="onRetryFavorite">重试原收藏操作</button>
      <button wx:if="{{favoriteState === 'error' && !favoritePendingOperation && catalogMode === 'cloud'}}" class="more-button" bindtap="onRetryFavorites">重试读取收藏</button>
      <view class="correction-box" wx:if="{{!isExperience && !isProduction}}">
        <view class="correction-title">{{catalogMode === 'field-note' ? '纠错表单预览（不会提交）' : (catalogMode === 'cloud' ? '提交地点纠错' : '资料纠错流程演示（本地）')}}</view>
        <textarea maxlength="-1" disabled="{{correctionBusy}}" value="{{correctionText}}" bindinput="onCorrectionInput" placeholder="请输入1—{{correctionLimit}}个字的纠错说明，表情也计入字数"></textarea>
        <view class="correction-foot">{{correctionCount}} / {{correctionLimit}}</view>
        <button class="outline-button" disabled="{{correctionBusy || correctionState === 'submitting' || catalogMode === 'field-note'}}" bindtap="onSubmitCorrection">{{catalogMode === 'cloud' ? '提交纠错' : (catalogMode === 'field-note' ? '预览模式不可提交' : '提交纠错（本地演示）')}}</button>
        <view wx:if="{{correctionState === 'invalid'}}" class="error-copy">请填写1—200个字，表情也计入字数。</view>
        <view wx:if="{{correctionState === 'preview'}}" class="state-copy">{{correctionError}}</view>
        <view wx:if="{{correctionState === 'submitting'}}" class="state-copy">正在提交纠错…</view>
        <view wx:if="{{correctionState === 'pending'}}" class="success-copy">本地演示：进入待审核状态，不会修改地点资料。</view>
        <view wx:if="{{correctionState === 'submitted'}}" class="success-copy">{{correctionError}}</view>
        <view wx:if="{{correctionState === 'error'}}" class="error-copy">{{correctionError}}；输入已保留。</view>
        <button wx:if="{{correctionState === 'error' && catalogMode === 'cloud'}}" class="more-button" bindtap="onRetryCorrection">使用原请求重试</button>
        <view wx:if="{{correctionState === 'pending' && catalogMode === 'synthetic'}}">
          <button class="more-button" bindtap="onReviewDemo" data-status="approved">模拟审核通过</button>
          <button class="more-button" bindtap="onReviewDemo" data-status="rejected">模拟审核驳回</button>
        </view>
        <view wx:if="{{correctionState === 'approved'}}">合成反馈：审核通过；未修改地点资料。</view>
        <view wx:if="{{correctionState === 'rejected'}}">合成反馈：需要补充依据。输入已保留，可修改后再演示提交。</view>
      </view>
    </view>

    <view class="weather-preview-section" wx:if="{{!isProduction}}">
      <button id="campus-weather-preview" class="outline-button" bindtap="onToggleWeatherPreview" aria-expanded="{{weatherPreviewExpanded}}">{{weatherPreviewExpanded ? '收起固定天气示意' : '查看固定天气示意'}}</button>
      <view wx:if="{{weatherPreviewExpanded}}" class="weather-preview-card">
        <view class="section-title small-title">{{preview.label}}</view>
        <view class="weather-preview-grid">
          <view wx:for="{{preview.skies}}" wx:key="name" class="weather-preview-item"><text class="weather-preview-symbol">{{item.symbol}}</text><text>{{item.name}}</text></view>
        </view>
        <view class="state-copy">{{preview.description}}</view>
      </view>
    </view>

    <view class="support-card" wx:if="{{!isExperience && !isProduction}}">
      <view class="section-title small-title">支持资源</view>
      <view wx:if="{{supportState === 'pending'}}" class="state-copy">没有资料时显示空态；可以查询当前接入状态。</view>
      <view wx:if="{{supportState === 'loading'}}" class="state-copy">正在读取支持资源…</view>
      <view wx:if="{{supportState === 'empty'}}" class="state-copy">当前没有已核验且仍有效的支持资源。</view>
      <view wx:if="{{supportState === 'notImplemented'}}" class="state-copy">支持资料暂未开放，请稍后再来。</view>
      <view wx:if="{{supportState === 'error'}}" class="error-copy">{{supportError}}</view>
      <view wx:for="{{supportItems}}" wx:key="id" class="detail-line">{{item.name}} · {{item.description}} · 有效期至 {{item.validUntil}}</view>
      <button class="outline-button" disabled="{{supportState === 'loading'}}" bindtap="onSupportResources">{{supportState === 'loading' ? '正在读取…' : (supportState === 'error' || supportState === 'notImplemented' ? '重试读取支持资源' : (supportState === 'ready' || supportState === 'empty' ? '刷新支持资源' : '读取支持资源'))}}</button>
    </view>
  </view>
</scroll-view>

</block>
