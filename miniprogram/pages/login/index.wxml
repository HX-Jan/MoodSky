<share-entry wx:if="{{shareSinglePage}}" title="{{sharePageTitle}}" description="{{sharePageDescription}}" />
<block wx:if="{{!shareSinglePage}}">
  <app-status id="app-status" hide-home="{{true}}" />
  <view class="login-page">
    <view class="login-brand">
      <view class="app-logo"><image src="/assets/jiaqi/PARTLY_CLOUDY.png" mode="aspectFit" /></view>
      <view class="brand-name">MoodSky</view>
      <view class="login-description">记录心情，回顾自己的每一天</view>
    </view>
    <view class="login-actions">
      <view class="login-heading">{{wechatAuthenticated ? '欢迎回来' : registrationAvailable ? '重新开始' : '登录 MoodSky'}}</view>
      <view class="login-help">{{wechatAuthenticated ? '当前账号已登录，可继续查看自己的记录。' : registrationAvailable ? '重新注册将创建空账号，旧数据不会恢复。' : phoneLoginEnabled ? '使用微信授权的手机号登录，未注册的号码将自动创建账号。' : '使用微信登录，首次使用将自动注册账号。'}}</view>
      <checkbox-group class="agreement-group" bindchange="onAgreement">
        <label class="agreement">
          <checkbox value="agree" checked="{{agreed}}" color="#386e61" aria-label="同意隐私保护指引" />
          <view><text>我已阅读并同意</text><text class="privacy-link" catchtap="onPrivacy">《隐私保护指引》</text></view>
        </label>
      </checkbox-group>
      <button wx:if="{{phoneLoginEnabled && !registrationAvailable && !wechatAuthenticated}}" id="phone-login" class="login-button button-motion {{buttonMotionStates['phone']}}" open-type="{{agreed ? 'getPhoneNumber' : ''}}" bindgetphonenumber="onPhoneLogin" bindtap="onPhoneLoginTap" loading="{{wechatLoginBusy}}" disabled="{{wechatLoginBusy}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
        data-motion-key="phone" data-motion-disabled="{{wechatLoginBusy}}" bindtouchstart="onButtonPressStart" bindtouchend="onButtonPressRelease" bindtouchcancel="onButtonPressRelease" bindanimationend="onButtonPressAnimationEnd"
      >{{wechatLoginBusy ? '正在登录' : '手机号快捷登录'}}</button>
      <button wx:else id="wechat-login" class="login-button button-motion {{buttonMotionStates['wechat']}}" bindtap="onWechatLogin" loading="{{wechatLoginBusy}}" disabled="{{wechatLoginBusy}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
        data-motion-key="wechat" data-motion-disabled="{{wechatLoginBusy}}" bindtouchstart="onButtonPressStart" bindtouchend="onButtonPressRelease" bindtouchcancel="onButtonPressRelease" bindanimationend="onButtonPressAnimationEnd"
      >{{wechatLoginBusy ? (registrationAvailable ? '正在注册' : '正在登录') : wechatAuthenticated ? '进入小程序' : registrationAvailable ? (registrationPending ? '重试注册' : '重新注册') : '微信一键登录'}}</button>
      <view class="login-notice" wx:if="{{wechatLoginNotice}}" role="status" aria-live="polite">{{wechatLoginNotice}}</view>
      <button wx:if="{{phoneLoginEnabled && !registrationAvailable && !wechatAuthenticated}}" id="wechat-login-fallback" class="alternate-button button-motion {{buttonMotionStates['wechat']}}" bindtap="onWechatLogin" disabled="{{wechatLoginBusy}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
        data-motion-key="wechat" data-motion-disabled="{{wechatLoginBusy}}" bindtouchstart="onButtonPressStart" bindtouchend="onButtonPressRelease" bindtouchcancel="onButtonPressRelease" bindanimationend="onButtonPressAnimationEnd"
      >使用微信登录</button>
    </view>
    <view class="login-bottom">
      <button class="browse-button button-motion {{buttonMotionStates['browse']}}" bindtap="onBrowse" disabled="{{wechatLoginBusy}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
        data-motion-key="browse" data-motion-disabled="{{wechatLoginBusy}}" bindtouchstart="onButtonPressStart" bindtouchend="onButtonPressRelease" bindtouchcancel="onButtonPressRelease" bindanimationend="onButtonPressAnimationEnd"
      >暂不登录，先看看</button>
      <view class="login-footnote">{{phoneLoginEnabled ? '手机号用于登录和识别账号，记录仅自己可见' : '微信用于识别账号，记录仅自己可见'}}</view>
    </view>
  </view>
</block>
