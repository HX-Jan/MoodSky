page {
  background: #f7faf7;
  color: #263c32;
}
.login-page {
  min-height: calc(100vh - 100rpx);
  padding: 0 64rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.login-brand {
  text-align: center;
  padding-top: 80rpx;
}
.app-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto;
}
.app-logo image {
  width: 144rpx;
  height: 144rpx;
}
.brand-name {
  font-size: 48rpx;
  font-weight: 600;
  margin-top: 18rpx;
  letter-spacing: 1rpx;
}
.login-description {
  font-size: 26rpx;
  line-height: 1.7;
  color: #718077;
  margin-top: 10rpx;
}
.login-actions {
  margin-top: 76rpx;
}
.login-heading {
  font-size: 36rpx;
  font-weight: 600;
}
.login-help {
  font-size: 26rpx;
  color: #718077;
  line-height: 1.8;
  margin-top: 14rpx;
}
.agreement-group {
  margin: 24rpx 0 12rpx;
}
.agreement {
  min-height: 44px;
  display: flex;
  align-items: center;
  font-size: 25rpx;
  line-height: 1.8;
  color: #65756b;
}
.agreement checkbox {
  transform: scale(0.75);
  flex-shrink: 0;
  margin-left: -12rpx;
}
.privacy-link {
  color: #386e61;
}
.login-button {
  width: 100%;
  min-height: 104rpx;
  margin: 0;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  background: #386e61;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.8;
  border-radius: 52rpx;
}
.login-button::after,
.alternate-button::after,
.browse-button::after {
  border: 0;
}
.login-button[disabled] {
  background: #92b0a5;
  color: #fff;
}
.alternate-button,
.browse-button {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  color: #386e61;
  font-size: 27rpx;
  line-height: 1.8;
}
.alternate-button {
  margin: 12rpx 0 0;
  width: 100%;
}
.login-notice {
  line-height: 1.8;
  font-size: 25rpx;
  color: #915b37;
  margin-top: 18rpx;
  word-break: break-word;
}
.login-bottom {
  margin-top: auto;
  padding-top: 64rpx;
}
.browse-button {
  margin: 0 auto;
  color: #65756b;
}
.login-footnote {
  text-align: center;
  font-size: 22rpx;
  line-height: 1.8;
  color: #718077;
  padding-top: 12rpx;
}
@media (max-height: 650px) {
  .login-brand {
    padding-top: 28rpx;
  }
  .login-actions {
    margin-top: 36rpx;
  }
  .login-bottom {
    padding-top: 24rpx;
  }
}
