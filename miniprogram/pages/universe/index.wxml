<view class="page universe-page">
  <view class="title">回顾</view>

  <view class="card" wx:if="{{!isDemo}}">
    <empty-state title="回顾服务尚未连接" description="连接后可查看月历、天气分布和时间线。当前未开启演示，不显示模拟记录。" />
  </view>

  <block wx:if="{{isDemo}}">
    <view class="demo-banner">本地演示 · 模拟记录，不写入云端</view>

    <view class="card calendar-card">
      <view class="month-nav">
        <button class="month-button" bindtap="onPreviousMonth" disabled="{{calendarBusy}}" aria-label="上一个月">‹</button>
        <picker mode="date" fields="month" value="{{month}}" bindchange="onMonthPick">
          <view class="month-title">{{monthLabel}}</view>
        </picker>
        <button class="month-button" bindtap="onNextMonth" disabled="{{calendarBusy}}" aria-label="下一个月">›</button>
      </view>
      <view class="weekday-row">
        <text class="weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="week-row" wx:for="{{weeks}}" wx:key="index" wx:for-item="week" wx:for-index="weekIndex">
        <view
          wx:for="{{week}}"
          wx:key="key"
          wx:for-item="cell"
          class="day-cell {{cell.blank ? 'day-cell--blank' : ''}} {{cell.isToday ? 'day-cell--today' : ''}} {{cell.recorded ? 'day-cell--recorded' : ''}}"
          data-date="{{cell.date}}"
          data-id="{{cell.id}}"
          bindtap="onDayTap"
        >
          <block wx:if="{{!cell.blank}}">
            <text class="day-number">{{cell.day}}</text>
            <block wx:if="{{cell.recorded}}">
              <text class="day-icon">{{cell.icon}}</text>
              <text class="day-label">{{cell.label}}</text>
            </block>
          </block>
        </view>
      </view>
      <view class="calendar-summary">
        <text>{{monthSummary}}</text>
        <text wx:if="{{calendarBusy}}" class="calendar-busy">正在读取…</text>
      </view>
      <view class="calendar-empty-hint" wx:if="{{monthRecordCount === 0 && !calendarError && !calendarBusy}}">
        没有记录的日期会留白。
      </view>
      <view class="calendar-error" wx:if="{{calendarError}}">{{calendarError}}</view>
      <view class="calendar-hint">点选有天气的日期，查看当天记录</view>
    </view>

    <view class="entry-row">
      <button class="entry-button" bindtap="onOpenArchive">月份档案</button>
      <button class="entry-button" bindtap="onOpenInsights">分布与时间线</button>
    </view>

    <view class="card decoration-card">
      <view class="field-heading">本月装饰</view>
      <view class="decoration-state" wx:if="{{!decorationEnabled}}">
        装饰已关闭，记录和装饰配置仍保留。
      </view>
      <block wx:if="{{decorationEnabled}}">
        <view class="decoration-row">
          <text class="decoration-caption">背景</text>
          <text class="decoration-chip {{decorationFailed ? 'decoration-chip--degraded' : ''}}">{{decorationBackground}}</text>
        </view>
        <view class="decoration-row" wx:if="{{decorationStickers.length > 0}}">
          <text class="decoration-caption">贴纸</text>
          <view class="decoration-stickers">
            <view class="decoration-chip {{item.degraded ? 'decoration-chip--degraded' : ''}}" wx:for="{{decorationStickers}}" wx:key="key">
              <text>{{item.title}}</text>
              <text class="decoration-chip-caption">{{item.degraded ? '已降级 · ' : ''}}{{item.caption}}</text>
            </view>
          </view>
        </view>
        <view class="decoration-row" wx:if="{{decorationStickers.length === 0}}">
          <text class="decoration-caption">贴纸</text>
          <text class="decoration-caption">本月暂无贴纸</text>
        </view>
      </block>
      <view class="decoration-note" wx:if="{{decorationNote}}">{{decorationNote}}</view>
      <view class="decoration-actions">
        <button class="decoration-button" bindtap="onToggleDecoration">{{decorationEnabled ? '关闭装饰' : '开启装饰'}}</button>
      </view>
      <button class="demo-toggle" bindtap="onToggleDemoTools" aria-expanded="{{demoToolsExpanded}}">装饰演示工具 <text>{{demoToolsExpanded ? '收起' : '展开'}}</text></button>
      <block wx:if="{{demoToolsExpanded}}">
        <view class="decoration-actions">
          <button class="decoration-button" bindtap="onSimulateAssetFailure">{{decorationFailed ? '恢复素材' : '模拟素材失败'}}</button>
          <button class="decoration-button" bindtap="onAddSticker" disabled="{{decorationBusy || !decorationEnabled}}">添加贴纸</button>
          <button class="decoration-button" bindtap="onResetDecoration" disabled="{{decorationBusy || !decorationEnabled}}">重置装饰</button>
        </view>
        <view class="calendar-hint">模拟素材 · 配置版本 {{decorationVersion}}，仅用于本地演示。</view>
      </block>
    </view>
  </block>
</view>
