<share-entry wx:if="{{shareSinglePage}}" title="{{sharePageTitle}}" description="{{sharePageDescription}}" />
<block wx:if="{{!shareSinglePage}}">
<app-status />
<view class="page universe-page">
  <view class="title">我的天气宇宙</view>

  <view class="card" wx:if="{{!reviewEnabled}}">
    <empty-state title="回顾服务尚未连接" description="暂时无法读取天气记录，请稍后重试。" />
  </view>

  <block wx:if="{{reviewEnabled}}">
    <view class="demo-banner" wx:if="{{isDemo}}">{{isExperience ? '功能体验 · 记录与示例仅本次保留，未同步云端' : '本地演示 · 合成数据仅保留在本次会话，不写入云端'}}</view>

    <view class="month-privacy"><image class="design-icon" src="/assets/jiaqi/calendar-active.png" /><view class="month-nav">
        <button class="month-button button-motion {{buttonMotionStates['b1']}} {{((calendarBusy)) ? 'button-motion-disabled' : ''}}" bindtap="onPreviousMonth" disabled="{{calendarBusy}}" aria-label="上一个月" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b1'}}"
          data-motion-disabled="{{(calendarBusy)}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >‹</button>
        <picker mode="date" fields="month" value="{{month}}" bindchange="onMonthPick">
          <view class="month-title">{{monthLabel}}</view>
        </picker>
        <button class="month-button button-motion {{buttonMotionStates['b2']}} {{((calendarBusy)) ? 'button-motion-disabled' : ''}}" bindtap="onNextMonth" disabled="{{calendarBusy}}" aria-label="下一个月" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b2'}}"
          data-motion-disabled="{{(calendarBusy)}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >›</button>
      </view><view class="privacy-label"><image src="/assets/jiaqi/lock-active.png" />仅自己可见</view></view>
    <view class="view-tabs"><view class="view-tab active">月历</view><button class="view-tab button-motion {{buttonMotionStates['b3']}}" bindtap="onOpenArchive" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b3'}}"
      data-motion-disabled="{{false}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >天气卡</button></view>
    <view class="card calendar-card">
      <view class="weekday-row">
        <text class="weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="week-row" wx:for="{{weeks}}" wx:key="index" wx:for-item="week" wx:for-index="weekIndex">
        <view
          wx:for="{{week}}"
          wx:key="key"
          wx:for-item="cell"
          class="day-cell weather-{{cell.weather}} {{cell.blank ? 'day-cell--blank' : ''}} {{cell.isToday ? 'day-cell--today' : ''}} {{cell.recorded ? 'day-cell--recorded' : ''}}"
          data-date="{{cell.date}}"
          data-id="{{cell.id}}"
          bindtap="onDayTap"
          aria-label="{{cell.blank ? '' : cell.date + '，' + (cell.recorded ? cell.label + '，已记录' : '未记录')}}"
          aria-disabled="{{!cell.recorded}}"
          hover-class="{{cell.recorded ? 'day-cell-pressed' : 'none'}}"
          hover-start-time="20"
          hover-stay-time="70"
          role="{{cell.recorded ? 'button' : ''}}"
        >
          <block wx:if="{{!cell.blank}}">
            <text class="day-number">{{cell.day}}</text>
            <block wx:if="{{cell.recorded}}">
              <image class="day-icon" src="/assets/jiaqi/{{cell.weather}}.png" />
              <text class="day-label">{{cell.label}}</text>
            </block>
          </block>
        </view>
      </view>
      <view class="calendar-summary">
        <text>{{monthSummary}}</text>
        <text wx:if="{{calendarBusy}}" class="calendar-busy">正在读取…</text>
      </view>
      <view class="calendar-empty-hint" wx:if="{{monthRecordCount === 0 && !calendarError && !calendarBusy}}">
        本月还没有记录，去“今天”记一条吧。
      </view>
      <view class="calendar-error" wx:if="{{calendarError}}">{{calendarError}}</view>
      <button wx:if="{{calendarError}}" bindtap="onRetry" class="button-motion {{buttonMotionStates['b4']}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
        data-motion-key="{{'b4'}}"
        data-motion-disabled="{{false}}"
        bindtouchstart="onButtonPressStart"
        bindtouchend="onButtonPressRelease"
        bindtouchcancel="onButtonPressRelease"
        bindanimationend="onButtonPressAnimationEnd"
      >重新读取</button>
      <view class="calendar-hint">点击有天气的日期查看记录。</view>
    </view>

    <view class="entry-row">
      <button class="entry-button button-motion {{buttonMotionStates['b5']}}" bindtap="onOpenArchive" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
        data-motion-key="{{'b5'}}"
        data-motion-disabled="{{false}}"
        bindtouchstart="onButtonPressStart"
        bindtouchend="onButtonPressRelease"
        bindtouchcancel="onButtonPressRelease"
        bindanimationend="onButtonPressAnimationEnd"
      >月份档案</button>
      <button class="entry-button button-motion {{buttonMotionStates['b6']}}" bindtap="onOpenInsights" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
        data-motion-key="{{'b6'}}"
        data-motion-disabled="{{false}}"
        bindtouchstart="onButtonPressStart"
        bindtouchend="onButtonPressRelease"
        bindtouchcancel="onButtonPressRelease"
        bindanimationend="onButtonPressAnimationEnd"
      >天气回顾</button>
    </view>

    <button class="decoration-toggle button-motion {{buttonMotionStates['b7']}}" wx:if="{{reviewEnabled && !isExperience && !isProduction}}" bindtap="onToggleDecorationPanel" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b7'}}"
      data-motion-disabled="{{false}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >{{decorationPanel ? '收起本月装饰' : '本月装饰'}}</button>
    <view wx:if="{{isDemo && decorationPanel}}" class="card decoration-card">
      <view class="field-heading">本月装饰 <text wx:if="{{decorationReady}}" class="decoration-version">版本{{decorationVersion}}</text></view>
      <view class="decoration-state" wx:if="{{!decorationEnabled}}">
        装饰已关闭：这是偏好设置，不删除装饰配置，也不影响月历与记录展示。
      </view>
      <block wx:if="{{decorationEnabled && decorationReady}}">
        <view class="decoration-row">
          <text class="decoration-caption">背景</text>
          <text class="decoration-chip {{decorationFailed ? 'decoration-chip--degraded' : ''}}">{{decorationBackground}}</text>
        </view>
        <view class="decoration-row" wx:if="{{decorationStickers.length > 0}}">
          <text class="decoration-caption">贴纸（{{decorationStickers.length}}/{{decorationLimit}}）</text>
          <view class="decoration-stickers">
            <view class="decoration-chip {{item.degraded ? 'decoration-chip--degraded' : ''}}" wx:for="{{decorationStickers}}" wx:key="key">
              <text>{{item.title}}</text>
              <text class="decoration-chip-caption">{{item.degraded ? '已降级 · ' : ''}}{{item.caption}}</text>
            </view>
          </view>
        </view>
        <view class="decoration-row" wx:if="{{decorationStickers.length === 0}}">
          <text class="decoration-caption">贴纸</text>
          <text class="decoration-caption">本月暂无贴纸</text>
        </view>
      </block>
      <view class="decoration-note" wx:if="{{decorationNote}}">{{decorationNote}}</view>
      <button wx:if="{{!decorationReady}}" class="decoration-button decoration-retry button-motion {{buttonMotionStates['b8']}} {{((decorationLoading || decorationBusy)) ? 'button-motion-disabled' : ''}}" bindtap="onRetryDecoration" disabled="{{decorationLoading || decorationBusy}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
        data-motion-key="{{'b8'}}"
        data-motion-disabled="{{(decorationLoading || decorationBusy)}}"
        bindtouchstart="onButtonPressStart"
        bindtouchend="onButtonPressRelease"
        bindtouchcancel="onButtonPressRelease"
        bindanimationend="onButtonPressAnimationEnd"
      >{{decorationLoading ? '正在读取装饰' : '重新读取装饰'}}</button>
      <view class="decoration-actions">
        <button class="decoration-button button-motion {{buttonMotionStates['b9']}}" bindtap="onToggleDecoration" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b9'}}"
          data-motion-disabled="{{false}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >{{decorationEnabled ? '关闭装饰' : '开启装饰'}}</button>
        <button class="decoration-button button-motion {{buttonMotionStates['b10']}}" bindtap="onSimulateAssetFailure" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b10'}}"
          data-motion-disabled="{{false}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >{{decorationFailed ? '恢复素材' : '模拟素材失败'}}</button>
        <button class="decoration-button decoration-add button-motion {{buttonMotionStates['b11']}} {{((decorationBusy || decorationLoading || !decorationReady || !decorationEnabled || decorationStickers.length >= decorationLimit)) ? 'button-motion-disabled' : ''}}" bindtap="onAddSticker" disabled="{{decorationBusy || decorationLoading || !decorationReady || !decorationEnabled || decorationStickers.length >= decorationLimit}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b11'}}"
          data-motion-disabled="{{(decorationBusy || decorationLoading || !decorationReady || !decorationEnabled || decorationStickers.length >= decorationLimit)}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >{{decorationStickers.length >= decorationLimit ? '贴纸已满' : '添加贴纸'}}</button>
        <button class="decoration-button decoration-reset button-motion {{buttonMotionStates['b12']}} {{((decorationBusy || decorationLoading || !decorationReady || !decorationEnabled)) ? 'button-motion-disabled' : ''}}" bindtap="onResetDecoration" disabled="{{decorationBusy || decorationLoading || !decorationReady || !decorationEnabled}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b12'}}"
          data-motion-disabled="{{(decorationBusy || decorationLoading || !decorationReady || !decorationEnabled)}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >重置装饰</button>
      </view>
      <view class="calendar-hint">当前使用合成素材演示；正式贴纸与背景尚待核验。</view>
    </view>

    <view wx:if="{{!isDemo && decorationPanel}}" class="card decoration-card">
      <view class="field-heading">本月装饰</view>
      <view class="decoration-state" wx:if="{{decorationState === 'loading'}}">{{decorationStateText}}</view>
      <view class="decoration-state" wx:if="{{decorationState === 'unimplemented'}}">{{decorationStateText}}</view>
      <view class="decoration-state" wx:if="{{decorationState === 'unavailable'}}">{{decorationStateText}}</view>
      <button class="decoration-button decoration-retry button-motion {{buttonMotionStates['b13']}}" wx:if="{{decorationState === 'unimplemented' || decorationState === 'unavailable'}}" bindtap="onRetryDecoration" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
        data-motion-key="{{'b13'}}"
        data-motion-disabled="{{false}}"
        bindtouchstart="onButtonPressStart"
        bindtouchend="onButtonPressRelease"
        bindtouchcancel="onButtonPressRelease"
        bindanimationend="onButtonPressAnimationEnd"
      >重新读取装饰</button>
      <block wx:if="{{decorationState === 'available'}}">
        <view class="decoration-row">
          <text class="decoration-caption">背景</text>
          <text class="decoration-chip">{{decorationBackground}}</text>
        </view>
        <view class="decoration-row" wx:if="{{decorationStickers.length > 0}}">
          <text class="decoration-caption">贴纸</text>
          <view class="decoration-stickers">
            <view class="decoration-chip" wx:for="{{decorationStickers}}" wx:key="key">
              <text>{{item.title}}</text>
              <text class="decoration-chip-caption">{{item.caption}}</text>
            </view>
          </view>
        </view>
        <view class="decoration-row" wx:if="{{decorationStickers.length === 0}}">
          <text class="decoration-caption">贴纸</text>
          <text class="decoration-caption">本月暂无贴纸</text>
        </view>
        <view class="decoration-note">已显示本月装饰。</view>
      </block>
      <view class="calendar-hint">暂时无法显示装饰时，请稍后重试。</view>
    </view>
  </block>
</view>

</block>
