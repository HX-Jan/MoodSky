.universe-page {
  padding: 26rpx 46rpx calc(180rpx + env(safe-area-inset-bottom));
}
.title {
  margin-bottom: 18rpx;
}
.design-subtitle {
  margin-bottom: 24rpx;
}
.demo-banner {
  font-size: 22rpx;
  margin-bottom: 24rpx;
}
.month-privacy {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin: 38rpx 0 30rpx;
}
.month-privacy > text {
  flex: 1;
  font-size: 38rpx;
}
.privacy-label {
  display: flex;
  gap: 10rpx;
  align-items: center;
  font-size: 25rpx;
  color: var(--color-primary);
}
.privacy-label image {
  width: 25rpx;
  height: 25rpx;
}
.view-tabs {
  display: flex;
  gap: 18rpx;
  margin-bottom: 38rpx;
}
.view-tab {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  background: #fff;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--color-muted);
  line-height: 1.5;
  margin: 0;
}
.view-tab.active {
  background: var(--color-brand-soft);
  border-color: var(--color-primary);
  color: var(--color-primary);
}
.calendar-card {
  padding: 20rpx 23rpx;
  border-radius: 38rpx;
}
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.month-button {
  background: transparent;
  color: var(--color-primary);
  min-height: 65rpx;
  margin: 0;
  padding: 6rpx 22rpx;
  line-height: 1.3;
  font-size: 38rpx;
}
.month-title {
  font-size: 26rpx;
  color: var(--color-muted);
  padding: 10rpx 14rpx;
}
.weekday-row,
.week-row {
  display: flex;
}
.weekday {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  color: var(--color-muted);
  padding: 12rpx 0;
}
.day-cell {
  flex: 1;
  min-width: 0;
  height: 90rpx;
  margin: 3rpx 2rpx;
  border-radius: 19rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.day-number {
  font-size: 23rpx;
  line-height: 1.3;
}
.day-cell--recorded.weather-SUNNY {
  background: var(--color-sunny);
}
.day-cell--recorded.weather-PARTLY_CLOUDY {
  background: var(--color-partly);
}
.day-cell--recorded.weather-CLOUDY {
  background: var(--color-cloudy);
}
.day-cell--recorded.weather-RAINY {
  background: var(--color-rainy);
}
.day-cell--recorded.weather-STORMY {
  background: var(--color-stormy);
}
.day-cell--recorded.weather-TYPHOON {
  background: var(--color-stormy);
}
.day-cell--recorded.weather-CUSTOM {
  background: var(--color-brand-soft);
}
.day-cell--today {
  border: 2rpx solid var(--color-primary);
}
.day-cell--blank {
  background: transparent;
}
.day-icon {
  width: 35rpx;
  height: 35rpx;
}
.day-label {
  display: none;
}
.calendar-summary {
  padding: 22rpx 6rpx 12rpx;
  color: var(--color-text);
  font-size: 27rpx;
}
.calendar-hint,
.calendar-empty-hint,
.calendar-busy,
.decoration-caption,
.decoration-note {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.6;
  margin: 12rpx 0;
}
.calendar-error {
  font-size: 25rpx;
  color: var(--color-danger);
}
.entry-row {
  display: flex;
  gap: 12rpx;
}
.entry-button,
.decoration-toggle,
.decoration-button {
  flex: 1;
  background: var(--color-brand-soft);
  color: var(--color-primary);
  font-size: 26rpx;
  border-radius: 23rpx;
  line-height: 1.5;
  padding: 20rpx;
  margin: 14rpx 0;
}
.decoration-toggle {
  width: 100%;
  background: transparent;
  border: 1rpx solid var(--color-border);
}
.field-heading {
  font-size: 32rpx;
}
.decoration-version {
  color: var(--color-muted);
  font-size: 23rpx;
}
.decoration-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 12rpx 0;
}
.decoration-chip {
  padding: 14rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 18rpx;
  font-size: 26rpx;
}
.decoration-chip-caption {
  font-size: 22rpx;
  color: var(--color-muted);
  margin-left: 8rpx;
}
.decoration-stickers {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
  gap: 12rpx;
}
.decoration-stickers .decoration-chip {
  display: flex;
  flex: 0 1 calc(50% - 6rpx);
  box-sizing: border-box;
  flex-direction: column;
  min-width: 0;
}
.decoration-stickers .decoration-chip-caption {
  margin-left: 0;
}
.decoration-chip--degraded {
  background: var(--color-background);
}
.decoration-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.decoration-state {
  color: var(--color-muted);
  font-size: 26rpx;
}
.month-privacy .month-nav {
  flex: 1;
  min-width: 0;
  margin: 0;
  justify-content: flex-start;
}
.month-privacy .month-title {
  padding: 0;
  font-size: 34rpx;
  color: var(--color-text);
}
.month-privacy .month-button {
  font-size: 29rpx;
  padding: 4rpx 12rpx;
  min-width: 48rpx;
}
