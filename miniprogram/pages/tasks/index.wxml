<share-entry wx:if="{{shareSinglePage}}" title="{{sharePageTitle}}" description="{{sharePageDescription}}" />
<block wx:if="{{!shareSinglePage}}">
<app-status />
<view class="page task-page">
  <view class="card" wx:if="{{tasksClosed}}"><empty-state title="小任务暂未开放" description="开放后可在这里选择任务。" /></view>
  <view class="card" wx:elif="{{!isDemo && !isCloud}}"><empty-state title="暂时无法读取任务" description="请稍后重新打开。" /></view>
  <block wx:if="{{isDemo || isCloud}}">
  <view wx:if="{{isDemo}}" class="demo-banner">{{isExperience ? '轻任务体验 · 示例建议与本页操作不写入云端' : '合成数据演示 · 不连接云服务，不写入真实账号'}}</view>

  <view class="card mode-card">
    <view class="title">{{view === 'history' ? '我的任务' : '小任务'}}</view>
    <view class="body" wx:if="{{view === 'suggestions' && !tasksReadOnly}}">挑一件现在想做的小事。</view>
    <view class="mode-row" wx:if="{{isDemo}}">
      <view>
        <view class="field-caption">当前状态</view>
        <view class="mode-label">{{modeLabel}}</view>
      </view>
      <button wx:if="{{isDemo && !tasksReadOnly}}" class="mode-button button-motion {{buttonMotionStates['b1']}}" bindtap="onToggleAuth" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
        data-motion-key="{{'b1'}}"
        data-motion-disabled="{{false}}"
        bindtouchstart="onButtonPressStart"
        bindtouchend="onButtonPressRelease"
        bindtouchcancel="onButtonPressRelease"
        bindanimationend="onButtonPressAnimationEnd"
      >{{toggleLabel}}</button>
    </view>
  </view>

  <view wx:if="{{notice}}" class="notice notice-{{noticeType}}" role="status">{{notice}}</view>
  <button wx:if="{{isCloud}}" disabled="{{loading || busy}}" bindtap="onRetry" class="button-motion {{buttonMotionStates['b2']}} {{((loading || busy)) ? 'button-motion-disabled' : ''}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
    data-motion-key="{{'b2'}}"
    data-motion-disabled="{{(loading || busy)}}"
    bindtouchstart="onButtonPressStart"
    bindtouchend="onButtonPressRelease"
    bindtouchcancel="onButtonPressRelease"
    bindanimationend="onButtonPressAnimationEnd"
  >{{retryPending ? '重试原操作' : '重新读取'}}</button>
  <view wx:if="{{loading}}">正在读取…</view>

  <button wx:if="{{isCloud && !tasksReadOnly && !isAuthenticated}}" bindtap="onWechatLogin" class="button-motion {{buttonMotionStates['b3']}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
    data-motion-key="{{'b3'}}"
    data-motion-disabled="{{false}}"
    bindtouchstart="onButtonPressStart"
    bindtouchend="onButtonPressRelease"
    bindtouchcancel="onButtonPressRelease"
    bindanimationend="onButtonPressAnimationEnd"
  >登录，开始任务</button>
  <view class="view-tabs">
    <button class="view-tab {{view === 'suggestions' ? 'view-tab--active' : ''}} button-motion {{buttonMotionStates['b4']}}" data-view="suggestions" bindtap="onView" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b4'}}"
      data-motion-disabled="{{false}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >任务建议</button>
    <button wx:if="{{!tasksReadOnly && (!isCloud || isAuthenticated)}}" class="view-tab {{view === 'history' ? 'view-tab--active' : ''}} button-motion {{buttonMotionStates['b5']}}" data-view="history" bindtap="onView" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b5'}}"
      data-motion-disabled="{{false}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >我的历史</button>
  </view>

  <view wx:if="{{view === 'suggestions'}}">
    <view class="task-card" wx:for="{{suggestions}}" wx:key="id">
      <view class="task-card-heading">
        <view class="task-title">{{item.title}}</view>
        <view wx:if="{{tasksReadOnly || item.state !== 'available'}}" class="task-state task-state--{{item.state}}">{{tasksReadOnly ? '建议' : item.stateLabel}}</view>
      </view>
      <view class="task-description">{{item.description}}</view>
      <view class="task-footer">
        <view class="task-meta">约 {{item.durationMin}} 分钟 · {{item.tagText}}</view>
        <button wx:if="{{item.canSelect && !tasksReadOnly && (!isCloud || isAuthenticated)}}" class="task-button task-choice button-motion {{buttonMotionStates['b6' + '_' + index]}} {{(((isCloud && writeBlocked) || busy || loading || retryPending)) ? 'button-motion-disabled' : ''}}" aria-label="选择{{item.title}}" data-task-id="{{item.id}}" data-action="select" disabled="{{(isCloud && writeBlocked) || busy || loading || retryPending}}" hover-class="task-choice--pressed button-motion-hover" bindtap="onTaskAction" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b6' + '_' + index}}"
          data-motion-disabled="{{((isCloud && writeBlocked) || busy || loading || retryPending)}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        ><text class="task-choice-label">选择</text></button>
      </view>
      <block wx:if="{{item.canComplete || item.canReplace || item.canSkip}}">
      <view class="task-actions" wx:if="{{!tasksReadOnly && (!isCloud || isAuthenticated)}}">
        <button wx:if="{{item.canComplete && item.destination}}" class="task-button task-button--primary button-motion {{buttonMotionStates['b7' + '_' + index]}} {{((busy || retryPending || storageBlocked)) ? 'button-motion-disabled' : ''}}" data-task-id="{{item.id}}" disabled="{{busy || retryPending || storageBlocked}}" bindtap="onOpenActivity" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b7' + '_' + index}}"
          data-motion-disabled="{{(busy || retryPending || storageBlocked)}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >{{item.destination === 'campus' ? '选校园地点' : '写心情记录'}}</button>
        <button wx:if="{{item.canComplete}}" class="task-button {{item.destination ? '' : 'task-button--primary'}} button-motion {{buttonMotionStates['b8' + '_' + index]}} {{(((isCloud && writeBlocked) || busy || loading || retryPending)) ? 'button-motion-disabled' : ''}}" data-task-id="{{item.id}}" data-action="complete" disabled="{{(isCloud && writeBlocked) || busy || loading || retryPending}}" bindtap="onTaskAction" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b8' + '_' + index}}"
          data-motion-disabled="{{((isCloud && writeBlocked) || busy || loading || retryPending)}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >完成</button>
        <button wx:if="{{item.canReplace}}" class="task-button button-motion {{buttonMotionStates['b9' + '_' + index]}} {{(((isCloud && writeBlocked) || busy || loading || retryPending)) ? 'button-motion-disabled' : ''}}" data-task-id="{{item.id}}" data-action="replace" disabled="{{(isCloud && writeBlocked) || busy || loading || retryPending}}" bindtap="onTaskAction" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b9' + '_' + index}}"
          data-motion-disabled="{{((isCloud && writeBlocked) || busy || loading || retryPending)}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >替换</button>
        <button wx:if="{{item.canSkip}}" class="task-button button-motion {{buttonMotionStates['b10' + '_' + index]}} {{(((isCloud && writeBlocked) || busy || loading || retryPending)) ? 'button-motion-disabled' : ''}}" data-task-id="{{item.id}}" data-action="skip" disabled="{{(isCloud && writeBlocked) || busy || loading || retryPending}}" bindtap="onTaskAction" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b10' + '_' + index}}"
          data-motion-disabled="{{((isCloud && writeBlocked) || busy || loading || retryPending)}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >跳过</button>
      </view>
      </block>
      <view wx:if="{{isDemo && !isAuthenticated}}" class="login-required">登录后可开始任务</view>
    </view>
  </view>

  <view wx:else class="history-panel">
    <view wx:if="{{isCloud}}" class="history-date">最近90天</view>
    <view wx:if="{{isDemo && !isAuthenticated}}" class="private-empty">登录后查看任务记录。</view>
    <view wx:elif="{{history.length === 0 && (isDemo || historyLoaded)}}" class="private-empty">{{isDemo ? '还没有演示任务记录。' : '还没有任务记录。'}}</view>
    <view wx:else class="history-list">
      <view class="history-item" wx:for="{{history}}" wx:key="id">
        <view class="history-date">{{item.date}}</view>
        <view class="history-title">{{item.title}}</view>
        <view class="history-state">{{item.stateLabel}}</view>
      </view>
    </view>
    <view wx:if="{{isCloud && historyMoreError}}" class="history-more-error" role="status">{{historyMoreError}}</view>
    <button wx:if="{{isCloud && historyHasMore}}" disabled="{{loading || busy || retryPending || historyLoadingMore}}" bindtap="onLoadMoreHistory" class="button-motion {{buttonMotionStates['b11']}} {{((loading || busy || retryPending || historyLoadingMore)) ? 'button-motion-disabled' : ''}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b11'}}"
      data-motion-disabled="{{(loading || busy || retryPending || historyLoadingMore)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >{{historyLoadingMore ? '正在加载…' : historyMoreError ? '重试加载更多' : '加载更多历史'}}</button>
    <view wx:if="{{isCloud && history.length && !historyHasMore && !loading}}" class="history-date">没有更多记录了</view>
  </view>
  </block>
</view>

</block>
