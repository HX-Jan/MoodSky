<share-entry wx:if="{{shareSinglePage}}" title="{{sharePageTitle}}" description="{{sharePageDescription}}" />
<block wx:if="{{!shareSinglePage}}">
<app-status id="app-status" hide-home="{{true}}" />
<view class="page review-page">
  <view class="demo-banner" wx:if="{{isDemo}}">{{isExperience ? '功能体验 · 记录与示例仅本次保留，未同步云端' : '本地演示 · 内容仅保留在本次会话'}}</view>
  <view class="privacy-banner">仅自己可见</view>

  <view class="detail-loading" wx:if="{{phase === 'loading'}}">正在读取…</view>

  <block wx:if="{{phase === 'ready'}}">
    <view class="card detail-card">
      <view class="detail-date">{{dateLabel}}</view>
      <view class="detail-weather">
        <text class="detail-icon">{{icon}}</text>
        <text class="detail-label">{{weatherLabel}}</text>
      </view>
      <view class="detail-tags" wx:if="{{tags.length > 0}}">
        <text class="detail-tag" wx:for="{{tags}}" wx:key="id">{{item.label}}</text>
      </view>
      <view class="detail-text">{{text}}</view>
      <view class="detail-meta">{{updatedAtText}}</view>
    </view>
  </block>

  <view class="card" wx:if="{{phase === 'missing'}}">
    <empty-state title="这一天没有记录" />
  </view>

  <view class="card" wx:if="{{phase === 'stale'}}">
    <empty-state title="该日期的记录已更新" description="请返回上一页，重新打开最新记录。" />
  </view>

  <view class="card" wx:if="{{phase === 'error'}}">
    <empty-state title="无法读取记录" description="{{errorMessage}}" />
    <button class="detail-retry" bindtap="onRetry">重新读取</button>
  </view>
  <button class="detail-back" bindtap="onBack">返回</button>
</view>

</block>
