<share-entry wx:if="{{shareSinglePage}}" title="{{sharePageTitle}}" description="{{sharePageDescription}}" />
<block wx:if="{{!shareSinglePage}}">
<app-status />
<view class="page review-page">
  <view class="title">天气回顾</view>

  <view class="card" wx:if="{{!reviewEnabled}}">
    <empty-state title="回顾服务尚未连接" description="暂时无法读取天气记录，请稍后重试。" />
  </view>

  <block wx:if="{{reviewEnabled}}">
    <view class="demo-banner" wx:if="{{isDemo}}">{{isExperience ? '功能体验 · 记录与示例仅本次保留，未同步云端' : '本地演示 · 合成数据仅保留在本次会话'}}</view>

    <view class="picker-row" wx:if="{{isDemo && !isExperience}}">
      <text class="picker-caption">数据来源</text>
      <view class="picker-options">
        <button class="picker-option {{sampleId === item.id ? 'picker-option--active' : ''}}" wx:for="{{samples}}" wx:key="id" data-id="{{item.id}}" bindtap="onSampleTap">{{item.label}}</button>
      </view>
    </view>
    <view class="picker-row">
      <text class="picker-caption">最近</text>
      <view class="picker-options">
        <button class="picker-option {{windowDays === item.days ? 'picker-option--active' : ''}}" wx:for="{{windows}}" wx:key="days" data-days="{{item.days}}" bindtap="onWindowTap" aria-label="{{item.label + (windowDays === item.days ? '，已选择' : '，未选择')}}" aria-pressed="{{windowDays === item.days}}">{{item.label}}</button>
      </view>
    </view>

    <view class="loading" wx:if="{{loading}}">正在读取…</view>
    <view class="operation-notice" wx:if="{{error}}">{{error}}</view>
    <button wx:if="{{error}}" bindtap="onRetry">重新读取</button>

    <block wx:if="{{!loading && !error}}">
      <view class="card">
        <view class="field-heading">天气分布</view>
        <view class="window-meta">{{metaText}}</view>
        <block wx:if="{{!distributionEmpty}}">
          <view class="dist-row" wx:for="{{distRows}}" wx:key="key">
            <text class="dist-icon">{{item.icon}}</text>
            <text class="dist-label">{{item.label}}</text>
            <view class="dist-bar-track">
              <view class="dist-bar" style="width: {{item.percent}}%;"></view>
            </view>
            <text class="dist-count">{{item.ratioText}}</text>
          </view>
          <view class="rule-note">按有记录的天数统计。</view>
        </block>
        <view class="empty-note" wx:if="{{distributionEmpty}}">这段时间还没有记录。</view>
        <view class="rule-note" wx:if="{{!distributionEmpty}}">{{blankText}}</view>
      </view>

      <view class="card">
        <view class="field-heading">记录时间线</view>
        <block wx:if="{{timelineItems.length > 0}}">
          <view class="timeline-item" wx:for="{{timelineItems}}" wx:key="key">
            <text class="timeline-date">{{item.date}}</text>
            <text class="timeline-icon">{{item.icon}}</text>
            <text class="timeline-label">{{item.label}}</text>
          </view>
        </block>
        <view class="empty-note" wx:if="{{timelineItems.length === 0}}">到“今天”记录天气，再回来看看。</view>
      </view>
    </block>
  </block>
</view>

</block>
