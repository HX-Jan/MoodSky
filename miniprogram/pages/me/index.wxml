<view class="page">
  <view class="eyebrow">ME</view>
  <view class="title">由你掌握自己的记录</view>
  <view class="card">
    <empty-state title="个人设置准备中" description="隐私偏好、本人导出和账号注销将在开发与验证后开放。" />
    <view class="body">卡片正文预览默认关闭。</view>
  </view>
  <view class="card">
    <view class="field-heading">小任务</view>
    <view class="body">浏览三条合成建议，体验登录后选择、完成、替换、跳过与历史路径。</view>
    <button class="task-entry" bindtap="onTasks">打开小任务演示</button>
  </view>
  <view class="hint">MoodSky {{version}}</view>
</view>
