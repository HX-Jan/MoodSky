<scroll-view scroll-y class="screen">
  <view class="hero">
    <view class="hero-title">我的</view>
    <view class="hero-subtitle">偏好设置与账号管理</view>
  </view>

  <view class="content">
    <view class="demo-banner">本地演示 · 仅含模拟数据，未连接云端</view>
    <view class="current-account">演示账号 {{accountId === 'demo-a' ? 'A' : 'B'}} · {{accountStatus === 'active' ? '正常' : accountStatus === 'closed' ? '已注销' : '已停用'}}</view>
    <view class="section-head">
      <view class="section-title">偏好设置</view>
    </view>
    <view class="preference-card">
      <view class="pref-row">
        <view class="pref-copy"><view class="pref-title">卡片正文预览</view><view class="pref-desc">默认隐藏正文</view></view>
        <switch data-key="cardTextPreview" checked="{{preferences.cardTextPreview}}" color="#bd79e5" bindchange="onPreviewChange" aria-label="卡片正文预览" />
      </view>
      <view class="divider"></view>
      <view class="pref-row">
        <view class="pref-copy"><view class="pref-title">天气装饰</view><view class="pref-desc">在回顾中显示背景和贴纸</view></view>
        <switch data-key="decorationsEnabled" checked="{{preferences.decorationsEnabled}}" color="#bd79e5" bindchange="onPreviewChange" aria-label="天气装饰" />
      </view>
      <view class="preview-note" aria-live="polite">{{syncState}}</view>
    </view>

    <view class="section-head second-head">
      <view class="section-title">数据与账号</view>
    </view>
    <view class="action-card export-card">
      <view class="action-main" bindtap="toggleExport" role="button" aria-label="查看记录导出流程">
        <view class="action-copy"><view class="action-title">导出记录</view><view class="action-desc">当前可试用演示文件</view></view>
        <view class="chevron">{{exportExpanded ? '⌃' : '›'}}</view>
      </view>
      <view wx:if="{{exportExpanded}}" class="action-detail">
        <view class="detail-title">选择文件格式 <text class="detail-tag">本地演示</text></view>
        <view class="format-row">
          <view wx:for="{{exportOptions}}" wx:key="*this" data-format="{{item}}" bindtap="chooseFormat" class="format-chip {{exportFormat === item ? 'format-active' : ''}}">{{item}}</view>
        </view>
        <view class="detail-line">合成任务状态：{{exportLabel}}</view>
        <view class="detail-help">仅生成演示账号偏好与空日记，不含真实数据。</view>
        <button class="outline-button" bindtap="startExport">生成 {{exportFormat}} 演示文件</button>
        <view wx:if="{{exportTask && exportTask.status === 'completed'}}" class="button-row">
          <button class="outline-button" bindtap="saveExport">保存到小程序本地</button>
          <button class="outline-button muted-button" bindtap="expireExport">模拟过期</button>
        </view>
      </view>
    </view>

    <view class="action-card closure-card">
      <view class="action-main" bindtap="toggleClosure" role="button" aria-label="查看账号停用流程">
        <view class="action-copy"><view class="action-title">停用与注销</view><view class="action-desc">查看演示流程和清理进度</view></view>
        <view class="chevron">{{closureExpanded ? '⌃' : '›'}}</view>
      </view>
      <view wx:if="{{closureExpanded}}" class="action-detail">
        <view class="detail-title">操作前请了解</view>
        <view class="closure-point">停用与注销仅操作当前本地合成账号。</view>
        <view class="detail-line">清理进度：{{closureProgress}}%</view>
        <view wx:if="{{closureNotice}}" class="detail-line">{{closureNotice}}</view>
        <view class="detail-help">不会停用微信身份，也不会删除云端数据。</view>
        <view class="button-row">
          <button class="outline-button closure-button" data-action="disable" bindtap="confirmAccount">模拟停用</button>
          <button class="outline-button closure-button" data-action="close" bindtap="confirmAccount">模拟注销</button>
        </view>
        <button class="outline-button muted-button reset-button" bindtap="resetDemo">重置当前演示账号</button>
      </view>
    </view>
    <button class="outline-button task-entry" bindtap="onTasks"><text>小任务</text><text class="chevron">›</text></button>
    <button class="demo-toggle" bindtap="toggleDemoTools" aria-expanded="{{demoToolsExpanded}}">演示工具 <text>{{demoToolsExpanded ? '收起' : '展开'}}</text></button>
    <block wx:if="{{demoToolsExpanded}}">
      <view class="account-switch">
        <view class="account-caption">演示账号：{{accountId}} · {{accountStatus}}</view>
        <view class="account-buttons">
          <button class="account-button {{accountId === 'demo-a' ? 'selected' : ''}}" data-id="demo-a" bindtap="switchAccount">账号 A</button>
          <button class="account-button {{accountId === 'demo-b' ? 'selected' : ''}}" data-id="demo-b" bindtap="switchAccount">账号 B</button>
        </view>
      </view>
      <view class="feedback-panel">
        <view class="detail-title">页面状态预览</view>
        <view class="format-row feedback-options">
          <button wx:for="{{feedbackOptions}}" wx:key="*this" data-state="{{item}}" bindtap="chooseFeedback" class="account-button {{feedbackState === item ? 'selected' : ''}}">{{item}}</button>
        </view>
        <status-feedback state="{{feedbackState}}" request-id="{{healthRequestId}}" bind:action="onFeedbackAction" />
        <view class="health-row">
          <view class="detail-help">本地检查：{{healthText}}</view>
          <button class="outline-button" bindtap="runHealth">本地健康检查</button>
        </view>
      </view>
    </block>
    <view class="footer">MoodSky {{version}}</view>
  </view>
</scroll-view>
