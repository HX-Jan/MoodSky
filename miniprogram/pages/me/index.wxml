<view class="page" wx:if="{{isPilot}}">
  <view class="design-title">本人受限云测试</view>
  <view class="detail-help">本次只验证本人测试数据，尚未公开上线。测试记录由服务器确认后保存。</view>
  <view class="detail-help">正式偏好、导出与账号注销尚未开放，本页不提供合成账号的注销或导出按钮。</view>
  <button class="outline-button" bindtap="onTasks">查看本人测试任务历史</button>
  <button class="outline-button" bindtap="runHealth">{{healthButtonText}}</button>
  <view class="detail-help">{{healthText}}</view>
  <view class="detail-help" wx:if="{{healthRequestId}}">请求编号：{{healthRequestId}}</view>
</view>
<scroll-view scroll-y class="screen" wx:if="{{!isPilot}}"><view class="content">
<view class="design-title">照顾自己的小宇宙</view>
<view class="design-subtitle">不比较，也不需要连续打卡。</view>
<view class="profile-card"><view class="profile-avatar"><image src="/assets/jiaqi/PARTLY_CLOUDY.png" /></view><view><view class="profile-name">校园记录者</view><view class="profile-meta">本地演示账号 · 未连接真实身份</view></view></view>
<view class="menu"><button id="menu-preferences" class="menu-row" bindtap="onSection" data-section="preferences"><view class="menu-icon"><image src="/assets/jiaqi/settings-active.png" /></view><view class="menu-copy"><view class="menu-title">偏好设置</view><view class="menu-description">正文预览与天气装饰</view></view><image class="design-icon" src="/assets/jiaqi/chevron.png" /></button>
<button id="menu-favorites" class="menu-row" bindtap="onSection" data-section="favorites"><view class="menu-icon"><image src="/assets/jiaqi/heart-active.png" /></view><view class="menu-copy"><view class="menu-title">收藏地点</view><view class="menu-description">收下想去的校园角落</view></view><image class="design-icon" src="/assets/jiaqi/chevron.png" /></button>
<button id="menu-tasks" class="menu-row" bindtap="onTasks"><view class="menu-icon"><image src="/assets/jiaqi/leaf-active.png" /></view><view class="menu-copy"><view class="menu-title">任务历史</view><view class="menu-description">只记录自己确认的完成</view></view><image class="design-icon" src="/assets/jiaqi/chevron.png" /></button>
<button id="menu-privacy" class="menu-row" bindtap="onSection" data-section="privacy"><view class="menu-icon"><image src="/assets/jiaqi/lock-active.png" /></view><view class="menu-copy"><view class="menu-title">隐私与数据</view><view class="menu-description">数据范围、导出与注销</view></view><image class="design-icon" src="/assets/jiaqi/chevron.png" /></button>
<button id="menu-help" class="menu-row" bindtap="onSection" data-section="help"><view class="menu-icon"><image src="/assets/jiaqi/help-active.png" /></view><view class="menu-copy"><view class="menu-title">帮助与支持</view><view class="menu-description">资源核验情况与接入说明</view></view><image class="design-icon" src="/assets/jiaqi/chevron.png" /></button></view>
<view class="section-panel" wx:if="{{activeSection === 'preferences'}}"><view class="section-title">偏好设置</view>    <view class="account-switch">
      <view class="account-caption">演示账号：{{accountId}} · {{accountStatus}}</view>
      <view class="account-buttons">
        <button class="account-button {{accountId === 'demo-a' ? 'selected' : ''}}" data-id="demo-a" bindtap="switchAccount">账号 A</button>
        <button class="account-button {{accountId === 'demo-b' ? 'selected' : ''}}" data-id="demo-b" bindtap="switchAccount">账号 B</button>
      </view>
    </view>
    <view class="section-head">
      <view><view class="section-kicker">01 / PERSONALIZE</view><view class="section-title">让天空更像你</view></view>
      <view class="section-symbol">✿</view>
    </view>
    <view class="preference-card">
      <view class="preview-note"><text class="preview-note-dot">●</text> {{syncState}}</view>
      <view class="pref-row">
        <view class="pref-icon pref-icon-peach">▤</view>
        <view class="pref-copy"><view class="pref-title">卡片正文预览</view><view class="pref-desc">默认关闭，避免旁人看到你的文字</view></view>
        <switch data-key="cardTextPreview" checked="{{preferences.cardTextPreview}}" color="#386e61" bindchange="onPreviewChange" aria-label="卡片正文预览" />
      </view>
      <view class="divider"></view>
      <view class="pref-row">
        <view class="pref-icon pref-icon-lilac">✧</view>
        <view class="pref-copy"><view class="pref-title">天气装饰</view><view class="pref-desc">给私人天气宇宙添一点色彩</view></view>
        <switch data-key="decorationsEnabled" checked="{{preferences.decorationsEnabled}}" color="#386e61" bindchange="onPreviewChange" aria-label="天气装饰" />
      </view>
      <view class="preview-footer">偏好自动保存到当前合成账号的本机缓存，不会同步到云端。</view>
    </view>

</view>
<view class="section-panel" wx:if="{{activeSection === 'privacy'}}"><view class="section-title">隐私与数据</view><view class="detail-help">以下仅操作本地合成账号，不修改微信身份或云端数据。</view>    <view class="action-card export-card">
      <view class="action-main" bindtap="toggleExport" role="button" aria-label="查看记录导出流程">
        <view class="action-icon">↓</view>
        <view class="action-copy"><view class="action-title">申请导出</view><view class="action-desc">仅导出本人数据，文件需身份校验</view></view>
        <view class="chevron">{{exportExpanded ? '⌃' : '›'}}</view>
      </view>
      <view wx:if="{{exportExpanded}}" class="action-detail">
        <view class="detail-title">选择文件格式 <text class="detail-tag">本地演示</text></view>
        <view class="format-row">
          <view wx:for="{{exportOptions}}" wx:key="*this" data-format="{{item}}" bindtap="chooseFormat" class="format-chip {{exportFormat === item ? 'format-active' : ''}}">{{item}}</view>
        </view>
        <view class="detail-line">合成任务状态：{{exportLabel}}</view>
        <view class="detail-help">仅生成演示账号偏好与空日记，不含真实数据。</view>
        <button class="outline-button" bindtap="startExport">生成 {{exportFormat}} 演示文件</button>
        <view wx:if="{{exportTask && exportTask.status === 'completed'}}" class="button-row">
          <button class="outline-button" bindtap="saveExport">保存到小程序本地</button>
          <button class="outline-button muted-button" bindtap="expireExport">模拟过期</button>
        </view>
      </view>
    </view>

    <view class="section-head second-head">
      <view><view class="section-kicker">03 / ACCOUNT</view><view class="section-title">账号与安心感</view></view>
      <view class="section-symbol section-symbol-pink">♡</view>
    </view>
    <view class="action-card closure-card">
      <view class="action-main" bindtap="toggleClosure" role="button" aria-label="查看账号停用流程">
        <view class="action-icon closure-icon">♧</view>
        <view class="action-copy"><view class="action-title">停用与注销</view><view class="action-desc">了解停用、清理与进度查询</view></view>
        <view class="chevron">{{closureExpanded ? '⌃' : '›'}}</view>
      </view>
      <view wx:if="{{closureExpanded}}" class="action-detail">
        <view class="detail-title">操作前请了解</view>
        <view class="closure-point">停用与注销仅操作当前本地合成账号。</view>
        <view class="detail-line">清理进度：{{closureProgress}}%</view>
        <view wx:if="{{closureNotice}}" class="detail-line">{{closureNotice}}</view>
        <view class="detail-help">不会停用微信身份，也不会删除云端数据。</view>
        <view class="button-row">
          <button class="outline-button closure-button" data-action="disable" bindtap="confirmAccount">模拟停用</button>
          <button class="outline-button closure-button" data-action="close" bindtap="confirmAccount">模拟注销</button>
        </view>
        <button class="outline-button muted-button reset-button" bindtap="resetDemo">重置当前演示账号</button>
      </view>
    </view>
</view>
<view class="section-panel" wx:if="{{activeSection === 'favorites'}}"><view class="section-title">收藏地点</view><view class="detail-help">收藏目前只保留在本次校园演示中，真实收藏服务尚未连接。</view><button class="outline-button" bindtap="onCampus">前往校园页</button></view>
<view class="section-panel" wx:if="{{activeSection === 'help'}}"><view class="section-title">帮助与支持</view><view class="detail-help">暂无经过学校核验的支持资源。下面为本地状态与健康检查演示。</view>    <view class="feedback-panel">
      <view class="format-row feedback-options">
        <button wx:for="{{feedbackOptions}}" wx:key="*this" data-state="{{item}}" bindtap="chooseFeedback" class="account-button {{feedbackState === item ? 'selected' : ''}}">{{item}}</button>
      </view>
      <status-feedback state="{{feedbackState}}" code="{{healthCode}}" request-id="{{healthRequestId}}" bind:action="onFeedbackAction" />
      <view class="health-row">
        <view class="detail-help">system.health（{{healthMode}}）：{{healthText}}</view>
        <view wx:if="{{healthVersion}}" class="detail-help">服务版本：{{healthVersion}}</view>
        <button class="outline-button" bindtap="runHealth">{{healthButtonText}}</button>
      </view>
    </view>
</view>
<view class="footer">本地演示 · MoodSky {{version}}</view></view></scroll-view>
