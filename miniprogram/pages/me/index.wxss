page {
  background: #fbf8ff;
}
.screen {
  height: 100vh;
  background: #fbf8ff;
}
.hero {
  padding: 32rpx 32rpx 36rpx;
  background: linear-gradient(130deg, #e6d5fa 0%, #f8dfed 49%, #fff0cc 100%);
  border-radius: 0 0 32rpx 32rpx;
  box-sizing: border-box;
}
.hero-title {
  color: #38234e;
  font-size: 42rpx;
  font-weight: 600;
}
.hero-subtitle {
  margin-top: 12rpx;
  color: #705c7f;
  font-size: 24rpx;
}
.content {
  padding: 28rpx 32rpx 32rpx;
}
.section-head {
  margin: 0 0 16rpx;
}
.section-title {
  color: #372943;
  font-size: 28rpx;
  font-weight: 600;
}
.preference-card,
.action-card {
  background: #fff;
  border-radius: 24rpx;
}
.preference-card {
  padding: 8rpx 24rpx 20rpx;
}
.preview-note {
  color: #8056a7;
  font-size: 22rpx;
  padding-top: 16rpx;
  line-height: 1.5;
}
.pref-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
}
.pref-copy {
  flex: 1;
  min-width: 0;
}
.pref-title {
  color: #382d43;
  font-size: 27rpx;
  font-weight: 600;
}
.pref-desc {
  color: #82748b;
  font-size: 22rpx;
  margin-top: 6rpx;
}
switch {
  transform: scale(0.78);
  transform-origin: right center;
  margin-left: 3rpx;
}
.divider {
  height: 1rpx;
  background: #f4eff6;
}
.second-head {
  margin-top: 32rpx;
}
.action-card {
  overflow: hidden;
}
.action-main {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.action-copy {
  flex: 1;
}
.action-title {
  color: #382d43;
  font-weight: 600;
  font-size: 28rpx;
}
.action-desc {
  margin-top: 8rpx;
  color: #82748b;
  font-size: 22rpx;
}
.chevron {
  color: #a99ab2;
  font-size: 40rpx;
  padding-left: 10rpx;
}
.action-detail {
  border-top: 1rpx solid #f4eff6;
  padding: 25rpx 28rpx 30rpx;
}
.detail-title {
  font-size: 25rpx;
  color: #4b3d56;
  font-weight: 600;
}
.detail-tag {
  margin-left: 12rpx;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  background: #fff1da;
  color: #ac7642;
  font-weight: 400;
  font-size: 19rpx;
}
.format-row {
  display: flex;
  gap: 14rpx;
  margin: 20rpx 0 26rpx;
}
.format-chip {
  padding: 11rpx 33rpx;
  background: #f7f4f9;
  color: #81758a;
  border-radius: 30rpx;
  font-size: 23rpx;
}
.format-active {
  background: #ead5fa;
  color: #7648a3;
  font-weight: 600;
}
.detail-line {
  color: #686079;
  font-size: 22rpx;
  line-height: 1.6;
}
.detail-help {
  color: #9b8ea2;
  font-size: 21rpx;
  line-height: 1.6;
  margin: 18rpx 0;
}
.outline-button {
  margin: 0;
  background: #f2f8fe;
  color: #638eb2;
  border-radius: 20rpx;
  font-size: 23rpx;
}
.closure-point {
  color: #73677d;
  font-size: 22rpx;
  line-height: 1.7;
  margin-top: 14rpx;
}
.closure-button {
  background: #fff2f4;
  color: #c67c90;
}
.footer {
  padding: 28rpx 0 12rpx;
  text-align: center;
  color: #82748b;
  font-size: 21rpx;
}

.demo-banner {
  margin-bottom: 28rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fff8e5;
  color: #7b6737;
  font-size: 22rpx;
  line-height: 1.5;
}

.account-switch {
  margin: 16rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.account-caption {
  color: #66586f;
  font-size: 23rpx;
  font-weight: 600;
}

.account-buttons,
.button-row,
.health-row {
  display: flex;
  gap: 14rpx;
}

.account-buttons {
  margin-top: 18rpx;
}

.account-button {
  min-width: 120rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #f5f1f8;
  color: #75687e;
  font-size: 21rpx;
  line-height: 64rpx;
}

.account-button::after,
.muted-button::after,
.reset-button::after {
  border: 0;
}

.account-button.selected {
  background: #ead5fa;
  color: #70469a;
  font-weight: 700;
}

.button-row {
  margin-top: 18rpx;
}

.button-row .outline-button {
  flex: 1;
}

.muted-button {
  background: #f5f2f7;
  color: #786e80;
}

.reset-button {
  width: 100%;
  margin-top: 18rpx;
}

.feedback-panel {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.feedback-options {
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.feedback-options .account-button {
  min-width: 0;
  flex: 1 0 30%;
  padding: 0 12rpx;
  font-size: 18rpx;
}

.health-row {
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.health-row .detail-help {
  flex: 1;
  margin: 0;
}

.health-row .outline-button {
  flex: none;
}

button::after {
  border: 0;
}
.export-card {
  margin-bottom: 16rpx;
}
.task-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 10rpx 24rpx;
  background: #ffffff;
  color: #382d43;
  border-radius: 24rpx;
  font-size: 28rpx;
  text-align: left;
}
.demo-toggle {
  display: flex;
  justify-content: space-between;
  width: 100%;
  padding: 16rpx 0;
  margin-top: 24rpx;
  background: transparent;
  color: #82748b;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: left;
}

.current-account {
  color: #82748b;
  font-size: 22rpx;
  margin: -12rpx 0 28rpx;
}
