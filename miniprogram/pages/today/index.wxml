<view class="page">
  <view class="title">{{isToday ? '今天，是什么天气？' : '这一天，是什么天气？'}}</view>
  <view class="date-row">
    <picker mode="date" value="{{date}}" end="{{today}}" bindchange="onDate" disabled="{{inputLocked}}">
      <view class="date-chip">{{date}}<text wx:if="{{isToday}}" class="date-today"> · 今天</text><text class="date-change"> 更改</text></view>
    </picker>
    <view class="date-nav">
      <button class="nav-btn" bindtap="onPreviousDate" disabled="{{!canPreviousDate}}">‹</button>
      <button class="nav-btn nav-today" wx:if="{{!isToday}}" bindtap="onToday">今天</button>
      <button class="nav-btn" bindtap="onNextDate" disabled="{{!canNextDate}}">›</button>
    </view>
  </view>

  <view class="kind-note"><text>每一种天气，都可以在这里停留。</text><image src="/assets/jiaqi/PARTLY_CLOUDY.png" /></view>
  <view class="demo-banner" wx:if="{{isDemo}}">{{isExperience ? '功能体验 · 记录与示例仅本次保留，未同步云端' : '本地演示 · 仅保留本次记录'}}</view>
  <view class="demo-banner" wx:if="{{isPilot}}"><view>本人受限云测试 · 未公开上线</view><view>仅测试当天；正文及自定义天气名称以“合成”开头。</view></view>
  <!-- 未记录：选天气 -->
  <block wx:if="{{loaded && !entry}}">
    <view class="card weather-card">
      <view class="privacy-row"><view class="privacy-label"><image src="/assets/jiaqi/lock-active.png" />仅自己可见</view><text>每日一条</text></view>
      <view class="weather-prompt">选一种最贴近此刻的天气</view>
      <view class="weather-grid">
        <button wx:for="{{weatherOptions}}" wx:key="code" class="weather-cell weather-{{item.code}} {{item.selected ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="onWeather" disabled="{{inputLocked}}">
          <image class="weather-icon" src="{{item.image}}" mode="aspectFit" />
          <view class="weather-label">{{item.label}}</view>
        </button>
      </view>
      <view class="custom-weather" wx:if="{{weather === 'CUSTOM'}}">
        <view class="custom-weather-heading">给此刻的天气起个名字 <text>{{weatherNameCount}}/{{weatherNameLimit}}</text></view>
        <input class="custom-weather-input" value="{{weatherName}}" bindinput="onWeatherName" maxlength="-1" disabled="{{inputLocked}}" placeholder="例如：雨后彩虹" />
        <view class="field-caption">1—20个字，仅自己可见；emoji也计入长度。</view>
      </view>
      <view class="weather-explainer">天气没有好坏，按你的感受选择。风雨、暴雨统一选“雷雨”。</view>
      <view class="date-hint" wx:if="{{isOlderNewDate}}">新记录只支持今天及此前 29 天，已有旧记录可以编辑。</view>
      <button class="primary-button {{!canSave ? 'is-disabled' : ''}}" bindtap="onSave" disabled="{{!canSave}}" loading="{{phase === 'saving'}}">{{saveButtonText}}</button>
      <view class="operation-notice notice-{{noticeType}}">{{notice}}</view>
      <view class="retry-row" wx:if="{{pendingRetry}}">
        <button class="retry-button" bindtap="onRetry" disabled="{{!canRetry}}">重试原操作</button>
        <button class="reload-button" bindtap="onReload" disabled="{{!canReload}}">重新读取</button>
      </view>
    </view>
    <view class="entry-list">
      <button class="entry-item" bindtap="onWrite" disabled="{{inputLocked}}">
        <view class="entry-main">
          <view class="entry-title">想写几句？标签和文字都可留白</view>

        </view>
        <view class="entry-arrow">›</view>
      </button>
      <button class="entry-item needs-entry" bindtap="onNeeds" disabled="{{inputLocked}}">
        <image class="needs-icon" src="/assets/jiaqi/leaf-active.png" /><view class="entry-main">
          <view class="entry-title">此刻，我想要…</view>
          <view class="entry-caption">找个角落，或做件很小的事</view>
        </view>
        <view class="entry-arrow">›</view>
      </button>
    </view>
  </block>

  <!-- 已有记录 -->
  <block wx:if="{{loaded && entry}}">
    <view class="saved-card">
      <view class="saved-date">{{entry.date}}<text wx:if="{{isToday}}"> · 今天</text></view>
      <view class="saved-weather">
        <image class="saved-icon" src="/assets/jiaqi/{{entry.weather}}.png" />
        <text class="saved-label">{{entryWeatherLabel}}</text>
      </view>
      <view class="saved-tags" wx:if="{{entryTagText}}">{{entryTagText}}</view>
      <view class="saved-empty">正文默认隐藏，进入私人记录页查看或修改。</view>
    </view>
    <button class="primary-button {{!canSave ? 'is-disabled' : ''}}" bindtap="onEditEntry" disabled="{{inputLocked}}">修改这条记录</button>
    <view class="entry-list">
      <button class="entry-item" bindtap="onNeeds" disabled="{{inputLocked}}">
        <image class="needs-icon" src="/assets/jiaqi/leaf-active.png" /><view class="entry-main">
          <view class="entry-title">此刻，我想要…</view>
          <view class="entry-caption">做个小任务，或找个地方待一会</view>
        </view>
        <view class="entry-arrow">›</view>
      </button>
    </view>
    <view class="operation-notice notice-{{noticeType}}">{{notice}}</view>
  </block>

  <view class="loading-state" wx:if="{{!loaded && phase === 'loading'}}">正在读取…</view>
  <view class="operation-notice notice-{{noticeType}}" wx:if="{{!loaded && phase !== 'loading'}}">{{notice}}</view>
  <button class="reload-button" wx:if="{{!pendingRetry}}" bindtap="onReload" disabled="{{!canReload}}">重新读取</button>
  <view class="confirm-panel" wx:if="{{confirm === 'reload'}}">
    <view class="confirm-text">{{confirmationAction}}？当前未保存输入将被放弃。</view>
    <button class="reload-button confirm-reload" bindtap="onConfirmReload">确认放弃并读取</button>
    <button class="cancel-confirm" bindtap="onCancel">保留当前输入</button>
  </view>

  <view class="support-link"><image class="design-icon" src="/assets/jiaqi/help.png" />需要更多支持可在“我的”中查看</view>
  <view class="demo-tools" wx:if="{{isDemo && !isExperience}}">
    <button class="demo-tool" bindtap="onToggleDemoTools">{{showDemoTools ? '收起演示工具' : '演示工具'}}</button>
    <view wx:if="{{showDemoTools}}">
    <button class="demo-tool" bindtap="onDemoFailure" disabled="{{!canSave}}">演示连接失败与重试</button>
    <button class="demo-tool" bindtap="onDemoClear">清除演示数据</button>
    <text class="field-caption">仅用于验证页面反馈，不连接云服务。</text></view>
  </view>
</view>
