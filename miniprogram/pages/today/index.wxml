<view class="page">
  <view class="demo-banner" wx:if="{{isDemo}}">本地演示 · 内容仅保留在本次演示</view>

  <view class="date-row">
    <picker mode="date" value="{{date}}" end="{{today}}" bindchange="onDate" disabled="{{inputLocked}}">
      <view class="date-chip">{{date}}<text wx:if="{{isToday}}" class="date-today"> · 今天</text><text class="date-change"> 更改</text></view>
    </picker>
    <view class="date-nav">
      <button class="nav-btn" bindtap="onPreviousDate" disabled="{{!canPreviousDate}}">‹</button>
      <button class="nav-btn nav-today" wx:if="{{!isToday}}" bindtap="onToday">今天</button>
      <button class="nav-btn" bindtap="onNextDate" disabled="{{!canNextDate}}">›</button>
    </view>
  </view>
  <view class="record-status">{{recordStatus}}</view>

  <!-- 未记录：选天气 -->
  <block wx:if="{{loaded && !entry}}">
    <view class="title">{{isToday ? '今天的心情' : '这一天的心情'}}</view>
    <view class="intro">用一种天气记下来</view>
    <view class="card">
      <view class="weather-grid">
        <button wx:for="{{weatherOptions}}" wx:key="code" class="weather-cell weather-{{item.code}} {{item.selected ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="onWeather" disabled="{{inputLocked}}">
          <view class="weather-icon">{{item.icon}}</view>
          <view class="weather-label">{{item.label}}</view>
        </button>
      </view>
      <view class="date-hint" wx:if="{{isOlderNewDate}}">新记录只支持今天及此前 29 天，已有旧记录可以编辑。</view>
      <button class="primary-button" bindtap="onSave" disabled="{{!canSave}}" loading="{{phase === 'saving'}}">{{saveButtonText}}</button>
      <view class="operation-notice notice-{{noticeType}}">{{notice}}</view>
    </view>
    <view class="entry-list">
      <button class="entry-item" bindtap="onWrite" disabled="{{inputLocked}}">
        <view class="entry-main">
          <view class="entry-title">写点什么</view>
          <view class="entry-caption">标签和正文选填</view>
        </view>
        <view class="entry-arrow">›</view>
      </button>
    </view>
  </block>

  <!-- 已有记录 -->
  <block wx:if="{{loaded && entry}}">
    <view class="title">{{isToday ? '今天的记录' : '这一天的记录'}}</view>
    <view class="saved-card">
      <view class="saved-weather">
        <text class="saved-icon">{{entryWeatherIcon}}</text>
        <text class="saved-label">{{entryWeatherLabel}}</text>
      </view>
      <view class="saved-tags" wx:if="{{entryTagText}}">{{entryTagText}}</view>
      <view class="saved-empty">正文已隐藏，进入记录查看</view>
    </view>
    <button class="primary-button" bindtap="onEditEntry" disabled="{{inputLocked}}">修改这条记录</button>
    <view class="operation-notice notice-{{noticeType}}">{{notice}}</view>
  </block>

  <view class="loading-state" wx:if="{{!loaded && phase === 'loading'}}">正在读取…</view>
  <view class="operation-notice notice-{{noticeType}}" wx:if="{{!loaded && phase !== 'loading'}}">{{notice}}</view>
  <view class="retry-row" wx:if="{{pendingRetry}}">
    <button class="retry-button" bindtap="onRetry" disabled="{{!canRetry}}">重试原操作</button>
    <button class="reload-button" bindtap="onReload" disabled="{{!canReload}}">重新读取</button>
  </view>
  <button wx:if="{{!pendingRetry}}" class="reload-button" bindtap="onReload" disabled="{{!canReload}}">重新读取</button>
  <view class="confirm-panel" wx:if="{{confirm === 'reload'}}">
    <view class="confirm-text">{{confirmationAction}}？当前未保存输入将被放弃。</view>
    <button class="reload-button confirm-reload" bindtap="onConfirmReload">确认放弃并读取</button>
    <button class="cancel-confirm" bindtap="onCancel">保留当前输入</button>
  </view>

  <view class="demo-tools" wx:if="{{isDemo}}">
    <button class="demo-toggle" bindtap="onToggleDemoTools" aria-expanded="{{demoToolsExpanded}}">演示工具 <text>{{demoToolsExpanded ? '收起' : '展开'}}</text></button>
    <block wx:if="{{demoToolsExpanded}}">
      <button class="demo-tool" bindtap="onDemoFailure" disabled="{{!canSave}}">演示连接失败与重试</button>
      <button class="demo-tool" bindtap="onDemoClear">清除演示数据</button>
      <text class="field-caption">仅用于验证页面反馈，不连接云服务。</text>
    </block>
  </view>
</view>
