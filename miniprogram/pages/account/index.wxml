<share-entry wx:if="{{shareSinglePage}}" title="{{sharePageTitle}}" description="{{sharePageDescription}}" />
<block wx:if="{{!shareSinglePage}}">
<app-status />
<view class="page">
  <view class="title">账号与数据</view>
  <view class="card"><view class="notice" role="status">{{notice}}</view><button bindtap="onReload" disabled="{{busy || pendingKind || closure}}">重新连接</button></view>
  <view class="card" wx:if="{{authenticated && !closure}}">
    <view class="section-title">私人记录</view>
    <view class="help">天气、标签和正文仅自己可见。当前云端回顾卡片保持正文隐藏，点击记录可查看本人正文。</view>
    <view class="section-title">显示偏好</view>
    <view class="pref-row"><view><view class="pref-title">卡片正文预览</view><view class="pref-help">该偏好仅保留账号设置；当前正式回顾、月份档案和归档卡片始终隐藏正文。</view></view><switch data-key="cardTextPreview" checked="{{preferences.cardTextPreview}}" color="#386e61" disabled="{{busy || pendingKind}}" bindchange="onPreference" aria-label="卡片正文预览" /></view>
    <view class="pref-row"><view><view class="pref-title">天气装饰</view><view class="pref-help">当前正式版本尚未展示装饰，偏好会随账号保存。</view></view><switch data-key="decorationsEnabled" checked="{{preferences.decorationsEnabled}}" color="#386e61" disabled="{{busy || pendingKind}}" bindchange="onPreference" aria-label="天气装饰" /></view>
    <view class="section-title">导出本人数据</view>
    <view class="help">导出当前账号的记录与偏好。导出领取有效期为24小时，到期由服务器定时清理；数据发生变化后需重新申请。文件只经本人身份校验领取。</view>
    <view class="format-row" role="group" aria-label="导出格式"><button class="format-button {{exportFormat === 'json' ? 'format-button--active' : ''}}" bindtap="onExportFormat" data-format="json" disabled="{{busy || pendingKind}}" aria-label="选择 JSON 格式">JSON</button><button class="format-button {{exportFormat === 'markdown' ? 'format-button--active' : ''}}" bindtap="onExportFormat" data-format="markdown" disabled="{{busy || pendingKind}}" aria-label="选择 Markdown 格式">Markdown</button></view>
    <button bindtap="onExport" disabled="{{busy || pendingKind}}" aria-label="按当前格式申请导出">申请 {{exportFormat === 'json' ? 'JSON' : 'Markdown'}} 导出</button>
    <view wx:if="{{exportJob}}" class="export-state" role="status"><view class="help">导出状态：{{exportStateLabel}}</view><button wx:if="{{exportJob.state === 'pending' || exportJob.state === 'processing'}}" bindtap="onExportStatus" disabled="{{busy}}" aria-label="查询导出状态">查询导出状态</button><button wx:if="{{exportJob.state === 'ready'}}" bindtap="onSaveExport" disabled="{{busy}}" aria-label="保存导出文件">保存导出文件</button><button wx:if="{{exportJob.state === 'expired' || exportJob.state === 'failed'}}" bindtap="onExport" disabled="{{busy || pendingKind}}" aria-label="按原格式重新申请导出">按原格式重新申请</button></view>
    <view class="section-title">注销账号</view><view class="help">注销后立即停止私人访问，服务器继续清理数据。最小停用标记用于防止账号意外恢复；已导出到本机的文件由你自行管理。</view>
    <button class="danger" bindtap="onClose" disabled="{{busy || pendingKind}}">注销 MoodSky 账号</button>
  </view>
  <view class="card" wx:if="{{pendingKind}}"><view class="help">上次操作的结果尚未确认，请保留原操作重试。</view><button bindtap="onRetry" disabled="{{busy}}">重试原操作</button></view>
  <view class="card" wx:if="{{closure}}"><view class="section-title">账号已停用</view><view class="help">清理状态：{{closure.state === 'completed' ? '已完成' : '处理中'}}</view><button bindtap="onCleanupStatus" disabled="{{busy}}">查询清理进度</button></view>
</view>

</block>
