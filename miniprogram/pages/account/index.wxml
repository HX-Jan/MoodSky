<share-entry wx:if="{{shareSinglePage}}" title="{{sharePageTitle}}" description="{{sharePageDescription}}" />
<block wx:if="{{!shareSinglePage}}">
<app-status />
<view class="page">
  <view class="title">账号与数据</view>
  <view class="card" wx:if="{{phoneLoginEnabled && authenticated && !closure}}">
    <view class="section-title">{{phoneSignedIn ? '手机号账号' : '关联手机号'}}</view>
    <view wx:if="{{phoneSignedIn}}" class="help">{{phoneAccountLabel || '手机号已验证'}}。切换号码时，请先退出，再使用其他手机号登录。不同账号的记录不会合并。</view>
    <block wx:else>
      <view class="help">关联后可使用该手机号登录并访问现有记录。请选择你本人使用的手机号；暂不支持更换已关联号码。</view>
      <button open-type="getPhoneNumber" bindgetphonenumber="onBindPhone" disabled="{{busy || pendingKind || phoneBindingBusy}}" loading="{{phoneBindingBusy}}">验证并关联手机号</button>
    </block>
    <view class="notice" role="status" wx:if="{{phoneBindingNotice}}">{{phoneBindingNotice}}</view>
  </view>
  <view class="card status-card" wx:if="{{notice || busy || pendingKind}}">
    <view class="notice" role="status" aria-live="polite">{{notice || (busy ? '正在处理…' : '上次操作尚未确认，请重试原操作。')}}</view>
    <button wx:if="{{pendingKind}}" class="account-retry button-motion {{buttonMotionStates['b1']}} {{((busy) || (busy)) ? 'button-motion-disabled' : ''}}" bindtap="onRetry" disabled="{{busy}}" loading="{{busy}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b1'}}"
      data-motion-disabled="{{(busy) || (busy)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >重试原操作</button>
    <button wx:elif="{{accountEnabled && !authenticated && !closure}}" bindtap="onReload" disabled="{{busy}}" loading="{{busy}}" class="button-motion {{buttonMotionStates['b2']}} {{((busy) || (busy)) ? 'button-motion-disabled' : ''}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b2'}}"
      data-motion-disabled="{{(busy) || (busy)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >重新连接</button>
  </view>
  <view class="card" wx:if="{{authenticated && !closure}}">
    <view class="section-title">导出本人数据</view>
    <view class="help">导出自己的记录与偏好，文件24小时内可领取。记录有变化时请重新申请。</view>
    <view class="format-row" role="group" aria-label="导出格式"><button class="format-button {{exportFormat === 'json' ? 'format-button--active' : ''}} button-motion {{buttonMotionStates['b3']}} {{((busy || pendingKind)) ? 'button-motion-disabled' : ''}}" bindtap="onExportFormat" data-format="json" disabled="{{busy || pendingKind}}" aria-label="选择数据文件，适合备份" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b3'}}"
      data-motion-disabled="{{(busy || pendingKind)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >数据文件</button><button class="format-button {{exportFormat === 'markdown' ? 'format-button--active' : ''}} button-motion {{buttonMotionStates['b4']}} {{((busy || pendingKind)) ? 'button-motion-disabled' : ''}}" bindtap="onExportFormat" data-format="markdown" disabled="{{busy || pendingKind}}" aria-label="选择文本文件，方便阅读" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b4'}}"
      data-motion-disabled="{{(busy || pendingKind)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >文本文件</button></view>
    <view class="pref-help">数据文件适合备份，文本文件方便阅读。</view>
    <button bindtap="onExport" disabled="{{busy || pendingKind}}" aria-label="按当前格式申请导出" class="button-motion {{buttonMotionStates['b5']}} {{((busy || pendingKind)) ? 'button-motion-disabled' : ''}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b5'}}"
      data-motion-disabled="{{(busy || pendingKind)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >导出{{exportFormat === 'json' ? '数据文件' : '文本文件'}}</button>
    <view wx:if="{{exportJob}}" class="export-state" role="status"><view class="help">导出状态：{{exportStateLabel}}</view><button wx:if="{{exportJob.state === 'pending' || exportJob.state === 'processing' || exportJob.state === 'ready'}}" bindtap="onExportStatus" disabled="{{busy || pendingKind}}" aria-label="查询导出状态" class="button-motion {{buttonMotionStates['b6']}} {{((busy || pendingKind)) ? 'button-motion-disabled' : ''}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b6'}}"
      data-motion-disabled="{{(busy || pendingKind)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >查询导出状态</button><block wx:if="{{exportJob.state === 'ready'}}"><button wx:if="{{exportChannel}}" bindtap="onSaveExport" disabled="{{busy || pendingKind}}" class="button-motion {{buttonMotionStates['b7']}} {{((busy || pendingKind)) ? 'button-motion-disabled' : ''}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b7'}}"
      data-motion-disabled="{{(busy || pendingKind)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >{{exportChannel === 'disk' ? '保存到电脑' : '发送文件到微信聊天'}}</button><block wx:if="{{exportTextAvailable}}"><button bindtap="onSaveExportText" disabled="{{busy || pendingKind}}" class="button-motion {{buttonMotionStates['b8']}} {{((busy || pendingKind)) ? 'button-motion-disabled' : ''}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b8'}}"
      data-motion-disabled="{{(busy || pendingKind)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >领取兼容文本</button><view class="help">兼容文件保留原格式内容。需要原扩展名时，去掉文件名末尾的 .txt。</view></block><button bindtap="onPreviewExport" disabled="{{busy || pendingKind}}" class="button-motion {{buttonMotionStates['b9']}} {{((busy || pendingKind)) ? 'button-motion-disabled' : ''}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b9'}}"
      data-motion-disabled="{{(busy || pendingKind)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >查看导出内容</button></block><button wx:if="{{exportJob.state === 'expired' || exportJob.state === 'failed'}}" bindtap="onReapplyExport" data-job-id="{{exportJob.jobId}}" disabled="{{busy || pendingKind}}" aria-label="按原格式重新申请导出" class="button-motion {{buttonMotionStates['b10']}} {{((busy || pendingKind)) ? 'button-motion-disabled' : ''}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b10'}}"
      data-motion-disabled="{{(busy || pendingKind)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >按原格式重新申请</button></view>
    <view class="export-preview" wx:if="{{exportPreviewTotal}}">
      <view class="help">本人导出内容 · {{exportPreviewIndex + 1}} / {{exportPreviewTotal}}</view>
      <scroll-view class="export-preview-content" scroll-y="{{true}}"><text user-select="{{true}}">{{exportPreview}}</text></scroll-view>
      <view class="format-row" wx:if="{{exportPreviewTotal > 1}}">
        <button class="format-button button-motion {{buttonMotionStates['b11']}} {{((exportPreviewIndex === 0)) ? 'button-motion-disabled' : ''}}" data-delta="-1" bindtap="onMoveExportPreview" disabled="{{exportPreviewIndex === 0}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b11'}}"
          data-motion-disabled="{{(exportPreviewIndex === 0)}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >上一页</button>
        <button class="format-button button-motion {{buttonMotionStates['b12']}} {{((exportPreviewIndex + 1 >= exportPreviewTotal)) ? 'button-motion-disabled' : ''}}" data-delta="1" bindtap="onMoveExportPreview" disabled="{{exportPreviewIndex + 1 >= exportPreviewTotal}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
          data-motion-key="{{'b12'}}"
          data-motion-disabled="{{(exportPreviewIndex + 1 >= exportPreviewTotal)}}"
          bindtouchstart="onButtonPressStart"
          bindtouchend="onButtonPressRelease"
          bindtouchcancel="onButtonPressRelease"
          bindanimationend="onButtonPressAnimationEnd"
        >下一页</button>
      </view>
      <button bindtap="onCloseExportPreview" class="button-motion {{buttonMotionStates['b13']}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
        data-motion-key="{{'b13'}}"
        data-motion-disabled="{{false}}"
        bindtouchstart="onButtonPressStart"
        bindtouchend="onButtonPressRelease"
        bindtouchcancel="onButtonPressRelease"
        bindanimationend="onButtonPressAnimationEnd"
      >关闭预览</button>
    </view>
    <button class="settings-toggle button-motion {{buttonMotionStates['b14']}} {{((busy || pendingKind)) ? 'button-motion-disabled' : ''}}" bindtap="onTogglePreferences" disabled="{{busy || pendingKind}}" aria-expanded="{{preferencesExpanded}}" aria-label="{{'显示设置，' + (preferencesExpanded ? '已展开' : '已收起')}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b14'}}"
      data-motion-disabled="{{(busy || pendingKind)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    ><text>显示设置</text><text class="settings-chevron">{{preferencesExpanded ? '⌃' : '⌄'}}</text></button>
    <view class="settings-details" wx:if="{{preferencesExpanded}}">
      <view class="pref-row"><view><view class="pref-title">卡片正文预览</view><view class="pref-help">设置会保存；回顾卡片暂时只显示日期和天气。</view></view><switch data-key="cardTextPreview" checked="{{preferences.cardTextPreview}}" color="#386e61" disabled="{{busy || pendingKind}}" bindchange="onPreference" aria-label="卡片正文预览" /></view>
      <view class="pref-row"><view><view class="pref-title">天气装饰</view><view class="pref-help">装饰暂未开放，设置会保存。</view></view><switch data-key="decorationsEnabled" checked="{{preferences.decorationsEnabled}}" color="#386e61" disabled="{{busy || pendingKind}}" bindchange="onPreference" aria-label="天气装饰" /></view>
    </view>
    <view class="section-title">注销账号</view><view class="help">注销后无法再访问账号，数据将继续清理。已保存到本机的导出文件需自行删除。</view>
    <button class="danger button-motion {{buttonMotionStates['b15']}} {{((busy || pendingKind)) ? 'button-motion-disabled' : ''}}" bindtap="onClose" disabled="{{busy || pendingKind}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
      data-motion-key="{{'b15'}}"
      data-motion-disabled="{{(busy || pendingKind)}}"
      bindtouchstart="onButtonPressStart"
      bindtouchend="onButtonPressRelease"
      bindtouchcancel="onButtonPressRelease"
      bindanimationend="onButtonPressAnimationEnd"
    >注销账号</button>
  </view>
  <view class="card" wx:if="{{closure}}"><view class="section-title">账号已停用</view><view class="help">清理状态：{{closure.state === 'completed' ? '已完成' : '处理中'}}</view><button bindtap="onCleanupStatus" disabled="{{busy}}" class="button-motion {{buttonMotionStates['b16']}} {{((busy)) ? 'button-motion-disabled' : ''}}" hover-class="button-motion-hover" hover-start-time="0" hover-stay-time="0"
    data-motion-key="{{'b16'}}"
    data-motion-disabled="{{(busy)}}"
    bindtouchstart="onButtonPressStart"
    bindtouchend="onButtonPressRelease"
    bindtouchcancel="onButtonPressRelease"
    bindanimationend="onButtonPressAnimationEnd"
  >查询清理进度</button></view>
</view>

</block>
