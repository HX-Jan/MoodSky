<share-entry wx:if="{{shareSinglePage}}" title="{{sharePageTitle}}" description="{{sharePageDescription}}" />
<block wx:if="{{!shareSinglePage}}">
<app-status />
<view class="profile-page">
  <form bindsubmit="onSave" wx:if="{{loaded}}">
    <view class="profile-fields"><button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{busy || pending}}" aria-label="选择头像"><text class="field-label">头像</text><view wx:if="{{!avatarPath && !avatarData}}" class="profile-avatar avatar-placeholder"><view class="avatar-head" /><view class="avatar-body" /></view><image wx:else class="profile-avatar" src="{{avatarPath || avatarData}}" mode="aspectFill" /><image class="field-arrow" src="/assets/jiaqi/chevron.png" /></button>
    <view class="nickname-field"><label class="field-label" for="nickname">昵称</label><input id="nickname" name="nickname" type="nickname" value="{{nickname}}" bindinput="onNicknameInput" bindblur="onNicknameInput" maxlength="40" placeholder="填写昵称" disabled="{{busy || pending}}" aria-label="昵称，最多20个字" /><image class="field-arrow" src="/assets/jiaqi/chevron.png" /></view></view>
    <view class="profile-help">头像、昵称均为选填。昵称最多20个字，未填写时显示“微信用户”。</view>
    <button class="reset-avatar" wx:if="{{avatarPath || avatarData}}" bindtap="onDefaultAvatar" disabled="{{busy || pending}}">恢复默认头像</button>
    <button class="save-profile" form-type="submit" loading="{{busy}}" disabled="{{busy || pending}}">保存</button>
  </form>
  <view class="profile-help" wx:if="{{!loaded && busy}}" role="status">正在读取个人资料…</view>
  <view class="profile-notice" wx:if="{{notice}}" role="status" aria-live="polite">{{notice}}</view>
  <button class="secondary" wx:if="{{pending}}" bindtap="onRetry" disabled="{{busy}}">重试原操作</button>
  <button class="secondary" wx:if="{{!loaded || notice}}" bindtap="onReload" disabled="{{busy}}">重新读取资料</button>
</view>

</block>
