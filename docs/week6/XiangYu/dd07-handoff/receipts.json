  "cases": [
    {
      "id": "R1",
      "event": "申请 JSON 导出（state=ready）",
      "request": "account.requestExport {format:\"json\"}",
      "response": {
        "apiVersion": "1",
        "requestId": "req_dd07_0005_qm0",
        "ok": true,
        "data": {
          "jobId": "5de780a80a2f99f9087b9f85dc3cfb82",
