      "event": "停用后申请新导出",
      "request": "account.requestExport {format:\"json\"}",
      "response": {
        "apiVersion": "1",
        "requestId": "req_dd07_0018_qm0",
        "ok": false,
        "error": {
          "code": "ACCOUNT_DISABLED",
          "message": "账号已停用。"
        }
      },
      "ui": "禁用申请入口，提示账号已停用",
      "c3": "账号停用后新建导出"
    },
